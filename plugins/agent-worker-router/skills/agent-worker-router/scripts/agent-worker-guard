    "export S={S}; rm -rf \"$S/x\"",
    "clickhouse format < {S}/q.sql",
    "clickhouse format --query 'CREATE TABLE t (x Int8) ENGINE = Memory'",
    # Real comments stay comments; quoted or commented commands are not run.
    "ls # rm -rf /", "git status # && git push --force", "grep -rn 'git push --force' .",
    "echo ${#x} ${p#pre} https://example.com/#top",
    # SQL comments and strings are read in one pass: an apostrophe in a comment opens no string.
    "clickhouse client -q \"-- today's rows\nSELECT a FROM t WHERE b = 'x' GROUP BY a\"",
    "clickhouse client -q \"/* don't */ SELECT 1\"",
    # A ClickHouse temporary table lives in the session only.
    "clickhouse client -q 'CREATE TEMPORARY TABLE tmp_x AS SELECT 1; INSERT INTO tmp_x SELECT 2; "
    "SELECT * FROM tmp_x; DROP TEMPORARY TABLE tmp_x'",
    "clickhouse client -q \"SELECT 1 # note; that's fine\"",
    # `shift` moves the arguments of a helper function; the word in a string moves nothing.
    "q() { local f=\"$1\"; shift; clickhouse client -q \"$*\" > {S}/out.txt; }; q a.txt \"SHOW TABLES\"; q b.txt 'SELECT 1'",
    "q() { printf '%s\\n' 'shift'; clickhouse client -q \"$1\"; }; q 'SELECT 1'",
    "q() { echo shift; clickhouse client -q \"$1\"; }; q 'SELECT 1'",
    # A quoted or escaped operator character is a word.
    "grep -c ';' {S}/q.sql", "tr '|' ' ' < {S}/q.sql", "find {S} -name x -exec ls {} \\;",
    # A file the text itself writes is read as written: an append adds to what was there.
    "echo 'SELECT 1' > {S}/q8.sql; echo 'UNION ALL SELECT 2' >> {S}/q8.sql; clickhouse client < {S}/q8.sql",
    "python3 -c 'print(1)'; echo 'SELECT 1' > {S}/q6.sql; clickhouse client --queries-file {S}/q6.sql",
    # A query in the arguments is the whole query: stdin is not read as SQL.
    "clickhouse client -q 'SELECT 1' < /dev/null",
    # `yt start-query`: the query follows the engine, whatever option values come before.
    "yt start-query --stage production yql 'SELECT 1'",
    "yt --proxy cluster start-query --settings '{a=1}' yql \"$(cat {S}/q.sql)\"",
    "engine=yql; yt start-query \"$engine\" 'SELECT 1'",
    "yt start-query -- yql 'SELECT 1'",
    "yt start-query --help",
    "yt start-query yql <<<'SELECT 1'",
    # A line of a heredoc is text, whatever it says; quoted operators side by side are one word.
    "q() { cat <<EOF\nshift\nEOF\nclickhouse client -q \"$1\"; }; q 'SELECT 1' 'not SQL'",
    "printf '%s' ';'';' yt start-query",
    # The descriptor number of a redirection is not a word of the command.
    "rm -rf {S}/build 2>/dev/null", "cd {O} && rm -rf {S}/x 2>&1",
    # A heredoc inside `$(...)` is one even in double quotes; its body is text.
    "x=\"$(cat <<'EOF'\nSELECT 1 -- rm -rf /\nEOF\n)\"; clickhouse client -q \"$x\"",
    "python3 - <<'EOF'\nprint(\"<<EOF is text here\")\nEOF\nls",
]
