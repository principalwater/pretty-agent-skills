# gives a meaning to (126 and 127 are "cannot run", which invites a retry outside the sandbox).
CONFIRM_REFUSED = 3
# The guard's words; the rules' "messages" table may replace any of them.
MESSAGES = {
    "codex_why": "A direct launch runs with the whole Codex config: every MCP server, its sandbox and approval "
