    "for f in {O}/a {O}/b; do rm -rf \"$f\"; done",
    "cd {O} && rm -rf build",
    "if true; then rm -rf {O}/x; fi",
    "while read f; do rm -rf \"$f\"; done < list.txt",
    "wipe() { rm -rf \"$1\"; }; wipe {O}/data",
    # `#` inside a word is not a comment: the rest of the line still counts.
    "x=(a b); [[ ${#x} -eq 2 ]] && rm -rf {O}/data", "echo ${#x}; git push --force origin main",
    "v=${p#pre}; git reset --hard HEAD~3", "curl -s https://example.com/#top; git reset --hard HEAD~3",
    "echo \"${#x}\"; git push --force origin main", "echo 'a # b'; rm -rf {O}/x",
    # Safety net: the parser cannot read this line (an unclosed quote), but it runs a watched command.
    "rm -rf {O}/data 'unclosed",
    # A SQL comment cannot hide a statement in a string it seems to open, nor a string in a comment.
    "clickhouse client -q \"/* don't */ DROP TABLE t\"",
    "clickhouse client -q \"-- it's\nDROP TABLE x; -- don't\"",
    "clickhouse client -q \"# it's\nDROP TABLE x; -- don't\"",
    # A temporary table covers one DROP TEMPORARY of its own plain name, nothing else.
    "clickhouse client -q 'CREATE TEMPORARY TABLE tmp_x AS SELECT 1; DROP TEMPORARY TABLE tmp_x; DROP TEMPORARY TABLE tmp_x'",
    "clickhouse client -q 'CREATE TEMPORARY TABLE tmp_x AS SELECT 1; DROP TABLE tmp_x'",
    "clickhouse client -q 'CREATE TEMPORARY TABLE tmp_x AS SELECT 1; DROP TEMPORARY TABLE tmp_x, prod'",
    "clickhouse client -q 'CREATE TEMPORARY TABLE `a` AS SELECT 1; DROP TEMPORARY TABLE `prod`'",
    # `shift`: the query is the argument left after it; after one in a loop, after `set --` and in the forms the
    # guard does not work out it is unknown.
    "q() { local n=\"$1\"; shift; clickhouse client -q \"$1\"; }; q 'SELECT 1' 'DROP TABLE t'",
    "q() { while [ $# -gt 1 ]; do shift; done; clickhouse client -q \"$1\"; }; q a 'SELECT 1'",
    "q() { set -- \"$2\" \"$1\"; clickhouse client -q \"$1\"; }; q 'SELECT 1' 'DROP TABLE t'",
    "q() { clickhouse client -q \"${@:2}\"; }; q x 'DROP TABLE t'",
    "q() { clickhouse client -q \"$*\"; }; q SELECT 1 \\; DROP TABLE t",
    # A quoted operator character does not end the command: the words after it are still its arguments.
    "rm -rf ';' {O}/data", "rm -rf '&' {O}/data", "rm -rf \"|\" {O}/data", "find {O} -name x -exec rm -rf {} \\;",
    # A query file the same text rewrites is not the copy an earlier run left on disk: its content is unknown.
    "python3 gen.py > {S}/q.sql; clickhouse client --queries-file {S}/q.sql",
    "sed -i '' 's/SELECT 1/DROP TABLE t/' {S}/q.sql; clickhouse client --queries-file {S}/q.sql",
    "cp {O}/other.sql {S}/q.sql && clickhouse client < {S}/q.sql",
    "python3 gen.py {S}/q.sql; clickhouse client -q \"$(cat {S}/q.sql)\"",
    "python3 gen.py {S}; clickhouse client --queries-file {S}/q.sql",
    # A later write undoes what an earlier command of the text made known, in the order they run.
    "echo 'SELECT 1' > {S}/q7.sql; python3 -c 'open(\"q7.sql\", \"w\").write(\"DROP TABLE t\")'; "
    "clickhouse client --queries-file {S}/q7.sql",
    "echo 'SELECT 1' > {S}/build/q.sql; python3 gen.py {S}/build; clickhouse client --queries-file {S}/build/q.sql",
    "cd \"$NOWHERE\"; python3 gen.py > {S}/q.sql; clickhouse client --queries-file {S}/q.sql",
    "python3 - <<'EOF'\nopen('q.sql', 'w').write('DROP TABLE t')\nEOF\ncd {S} && clickhouse client --queries-file q.sql",
    "echo 'DROP TABLE x;' > {S}/q9.sql; echo 'SELECT 1' >> {S}/q9.sql; clickhouse client < {S}/q9.sql",
    # Temporary tables: names are case-sensitive, and another engine may write outside the session.
    "clickhouse client -q 'CREATE TEMPORARY TABLE demo AS SELECT 1; INSERT INTO Demo SELECT 2'",
    "clickhouse client -q \"CREATE TEMPORARY TABLE t2 ENGINE = S3('u') AS SELECT 1\"",
    "clickhouse client -q 'CREATE TEMPORARY TABLE db AS SELECT 1; INSERT INTO db . real SELECT 2'",
    # A shift past the last argument fails and leaves them; a `shift` line in a heredoc shifts nothing.
    "q() { shift 2; clickhouse client -q \"$1\"; }; q 'DROP TABLE t'",
    "q() { cat <<EOF\nshift\nEOF\nclickhouse client -q \"$1\"; }; q 'DROP TABLE t' 'SELECT 1'",
    # A redirection writes the file it names, be the name digits; `--queries-file=` is the option with a value.
    "cd {S} && echo 'DROP TABLE t' > 1 && clickhouse client < 1",
    "clickhouse client --queries-file={O}/drop.sql",
    "clickhouse client --queries-file={O}/unknown.sql",
    "yt start-query --stage production yql 'DROP TABLE `//home/x`'",
    "yt start-query --stage production yql \"$Q\"",
    "yt start-query -- yql 'DROP TABLE `//home/x`'",
    "echo 'DROP TABLE x' | clickhouse client",
    "echo 'DROP TABLE x' | clickhouse client -q ''",
    "rm -rf {O}/data 2>/dev/null",
    # `<<WORD` in quotes or in a comment is not a heredoc: the lines after it are still commands.
    "echo \"see <<EOF\"\nrm -rf {O}/data",
    "sed -E 's/<<NAME:[^>]+>>/x/' a.sql > b.sql\nyt remove //home/x",
    "ls # <<EOF\nrm -rf {O}/data",
    "x=\"$(cat <<'EOF'\nDROP TABLE t\nEOF\n)\"; clickhouse client -q \"$x\"",
]
# With sql_ask "destructive": statements that only add go through, what removes or overwrites still asks, and a
# query the guard cannot read is refused (unknown_sql_decision "deny").
ADDS = [
    "clickhouse client -q 'SELECT 1'",
    "clickhouse client -q 'INSERT INTO t SELECT 1'",
    "clickhouse client -q 'CREATE TABLE IF NOT EXISTS t (x Int8) ENGINE = Memory'",
    "clickhouse client -q 'CREATE TABLE t ENGINE = ReplacingMergeTree ORDER BY x AS SELECT 1 AS x'",
    "clickhouse client -q 'CREATE VIEW v AS SELECT 1'",
    "clickhouse client -q 'INSERT INTO t SELECT truncate(x, 2) FROM s'",
    "clickhouse client -q 'SELECT 1 AS s3_truncate_on_insert'",
    "clickhouse client -q 'INSERT INTO t SELECT 1 SETTINGS s3_truncate_on_insert = 0'",
    "yt start-query yql 'INSERT INTO `//home/x` SELECT 1'",
    "yt start-query yql 'DEFINE ACTION $a() AS INSERT INTO `//x` SELECT 1; END DEFINE; DO $a()'",
]
REMOVES = [
    "clickhouse client -q 'DROP TABLE t'",
    "clickhouse client -q 'TRUNCATE TABLE t'",
    "clickhouse client -q 'ALTER TABLE t DELETE WHERE 1'",
    "clickhouse client -q 'ALTER TABLE t ADD COLUMN y Int8'",
    "clickhouse client -q 'RENAME TABLE a TO b'",
    "clickhouse client -q 'CREATE OR REPLACE TABLE t (x Int8) ENGINE = Memory'",
    "clickhouse client -q 'INSERT OVERWRITE TABLE t SELECT 1'",
    "clickhouse client -q 'CREATE USER u'",
    "clickhouse client -q 'OPTIMIZE TABLE t FINAL'",
    "clickhouse client -q 'KILL QUERY WHERE 1'",
    "clickhouse client -q 'INSERT INTO t SELECT 1; DROP TABLE t'",
    "yt start-query yql 'INSERT INTO `//home/x` WITH TRUNCATE SELECT 1'",
    "yt start-query yql 'DEFINE ACTION $a() AS INSERT INTO `//x` WITH TRUNCATE SELECT 1; END DEFINE; DO $a()'",
    "yt start-query yql 'DROP TABLE `//home/x`'",
    "clickhouse client -q \"INSERT INTO FUNCTION s3('u', 'TSV') SELECT 1 SETTINGS s3_truncate_on_insert = 1\"",
    "clickhouse client -q 'SET s3_truncate_on_insert = 1; INSERT INTO FUNCTION s3(1) SELECT 1'",
    "clickhouse client -q \"$Q\"",
]
MCP_CASES = [
    ("mcp__clickhouse__run_query", {'query': 'SELECT 1'}, False),
    ("mcp__clickhouse__run_query", {'query': 'SHOW CREATE TABLE t'}, False),
    ("mcp__clickhouse__run_query", {'query': 'DROP TABLE t'}, True),
    ("mcp__clickhouse__run_query", {'query': 'INSERT INTO t VALUES (1)'}, True),
    ("mcp__airflow__clear_dag_run", {'dag_id': 'd', 'dag_run_id': 'r'}, False),
    ("mcp__airflow__clear_dag_run", {'dag_id': 'd', 'dag_run_id': 'r', 'dry_run': False}, True),
    ("mcp__airflow__trigger_dag", {'dag_id': 'd'}, True),
