    # Real comments stay comments; quoted or commented commands are not run.
    "ls # rm -rf /", "git status # && git push --force", "grep -rn 'git push --force' .",
    "echo ${#x} ${p#pre} https://example.com/#top",
]
DESTRUCTIVE = [
    "rm -rf {O}/project",
    "rm -rf ~",
    "rm -rf \"$HOME/x\"",
    "rm -r build",
    "rm -fr {O}/a",
    "rm --recursive --force {O}",
    "/bin/rm -rf {O}/x",
    "rm -rf {S}/../../escape",
    "rm -rf $(cat list.txt)",
    "ls | xargs rm -rf",
    "find {O} -name '*.log' -delete",
    "find {O} -exec rm -rf {} \\;",
    "sudo ls",
    "git push --force",
    "git push -f origin feature",
    "git push origin +feature",
    "git push --delete origin x",
    "git push origin :x",
    "git push origin main",
    "git push origin HEAD:master",
    "git reset --hard HEAD~1",
    "git branch -D x",
    "git branch --delete x",
    "git clean -fdx",
    "git stash drop",
    "git stash clear",
    "git tag -d v1",
    "git reflog expire --expire=now --all",
    "git gc --prune=now",
    "clickhouse client -q 'ALTER TABLE t DROP PARTITION 1'",
    "clickhouse-client --query='RENAME TABLE a TO b'",
    "yt remove //home/x",
    "yt move //a //b",
    "yt set //x/@a 1",
    "yt create table //x",
    "yt start-query yql 'INSERT INTO `//home/x` SELECT 1'",
    "yt start-query yql 'DEFINE ACTION $a() AS INSERT INTO `//x` SELECT 1; END DEFINE; DO $a()'",
    "launchctl bootstrap gui/501 x.plist",
    "launchctl unload x.plist",
    "security find-generic-password -s x -w",
    "osascript -e 'beep'",
    "pkill -f node",
    "killall node",
    "crontab -r",
    "kubectl delete pod x",
    "diskutil eraseDisk APFS X disk9",
    "dd if=x of=/dev/disk9",
    "bash -c 'rm -rf {O}/x'",
    "echo 'rm -rf {O}/x' | bash",
    "zsh <<'EOF'\nrm -rf {O}/x\nEOF",
    "ssh host 'rm -rf /data'",
    "eval 'yt remove //x'",
    "out=$(yt remove //x)",
    "env X=1 git push --force",
    "T={O}/data; rm -rf \"$T\"",
    "for f in {O}/a {O}/b; do rm -rf \"$f\"; done",
    "cd {O} && rm -rf build",
    "if true; then rm -rf {O}/x; fi",
    "while read f; do rm -rf \"$f\"; done < list.txt",
    "wipe() { rm -rf \"$1\"; }; wipe {O}/data",
    # `#` inside a word is not a comment: the rest of the line still counts.
    "x=(a b); [[ ${#x} -eq 2 ]] && rm -rf {O}/data", "echo ${#x}; git push --force origin main",
    "v=${p#pre}; git reset --hard HEAD~3", "curl -s https://example.com/#top; git reset --hard HEAD~3",
    "echo \"${#x}\"; git push --force origin main", "echo 'a # b'; rm -rf {O}/x",
    # Safety net: the parser cannot read this line (an unclosed quote), but it runs a watched command.
    "rm -rf {O}/data 'unclosed",
]
MCP_CASES = [
    ("mcp__clickhouse__run_query", {'query': 'SELECT 1'}, False),
    ("mcp__clickhouse__run_query", {'query': 'SHOW CREATE TABLE t'}, False),
    ("mcp__clickhouse__run_query", {'query': 'DROP TABLE t'}, True),
    ("mcp__clickhouse__run_query", {'query': 'INSERT INTO t VALUES (1)'}, True),
    ("mcp__airflow__clear_dag_run", {'dag_id': 'd', 'dag_run_id': 'r'}, False),
    ("mcp__airflow__clear_dag_run", {'dag_id': 'd', 'dag_run_id': 'r', 'dry_run': False}, True),
    ("mcp__airflow__trigger_dag", {'dag_id': 'd'}, True),
    ("mcp__airflow__get_dag_run", {'dag_id': 'd', 'dag_run_id': 'r'}, False),
    ("mcp__airflow__list_dags", {}, False),
    ("mcp__clickhouse__list_tables", {'database': 'x'}, False),
    ("mcp__clickhouse-prod__run_query", {'query': 'TRUNCATE TABLE t'}, True),
    ("mcp__jira__create_issue", {'summary': 'x'}, True),
    ("mcp__jira__get_issue", {'issue_key': 'X-1'}, False),
    ("mcp__gitlab__run_job", {'job_id': 1}, True),
    ("mcp__gitlab__get_merge_request", {'iid': 1}, False),
    ("mcp__confluence__update_page", {'page_id': '1'}, True),
    ("mcp__confluence__get_page", {'page_id': '1'}, False),
    ("mcp__ccd_session_mgmt__delete_session", {'session_id': 'x'}, True),
]

# git push. Repositories the self-test makes in {R}: name -> (current branch, config); origin is a local bare repo.
GIT_REPOS = {
    "feature": ("feature", [("branch.feature.remote", "origin"), ("branch.feature.merge", "refs/heads/feature")]),
    "main": ("main", [("branch.main.remote", "origin"), ("branch.main.merge", "refs/heads/main")]),
    "master": ("master", []),
    "up-main": ("feature", [("branch.feature.remote", "origin"), ("branch.feature.merge", "refs/heads/main")]),
    "current": ("feature", [("push.default", "current"), ("branch.feature.merge", "refs/heads/main")]),
    "matching": ("feature", [("push.default", "matching")]),
    "nothing": ("feature", [("push.default", "nothing")]),
    "detached": ("feature", []),
    "pushspec": ("feature", [("remote.origin.push", "refs/heads/*:refs/heads/*")]),
    "pushspec-dev": ("feature", [("remote.origin.push", "refs/heads/feature:refs/heads/feature")]),
    "mirror": ("feature", [("remote.origin.mirror", "true")]),
    "pushremote": ("feature", [("branch.feature.pushRemote", "fork"), ("remote.fork.url", "/x/fork.git"),
                               ("remote.fork.push", "refs/heads/feature:refs/heads/main")]),
    "followtags": ("feature", [("push.followTags", "true")]),
    "tagged": ("feature", []),
    "other-repo": ("feature", []),
    "other-url": ("feature", [("remote.origin.url", "git@git.example:team/other-repo.git")]),
    # Remotes on a public host, for rules that ask there (directly, and through url.<base>.insteadOf).
    "public-url": ("feature", [("remote.origin.url", "git@github.com:team/repo.git")]),
    "insteadof": ("feature", [("url.git@github.com:.insteadOf", "gh:"), ("remote.origin.url", "gh:team/repo.git")]),
}
# (repository the push runs in, None for the self-test's directory; command; True when it must ask)
GIT_PUSH_CASES = [
    ("feature", "git push origin feature", False),
    ("feature", "git push -u origin feature", False),
    ("feature", "git push origin HEAD:refs/heads/dev-x", False),
    ("feature", "git push origin main:feature", False),
    ("feature", "git push -o ci.skip origin feature", False),
    ("feature", "git push https://example.invalid/r.git feature", False),
    ("feature", "git push origin HEAD", False),
    ("feature", "git push origin @", False),
    ("feature", "B=feature; git push origin \"$B\"", False),
    ("feature", "git push origin main", True),
    ("feature", "git push origin HEAD:main", True),
    ("feature", "git push origin x:refs/heads/master", True),
    ("feature", "git push origin 2839dbee:refs/heads/main", True),
    ("feature", "git push origin feature main", True),
    ("feature", "git push origin 'refs/heads/*:refs/heads/*'", True),
    ("feature", "git push https://example.invalid/r.git main", True),
    ("feature", "git push --dry-run origin main", True),
    ("feature", "git push --all origin", True),
    ("feature", "git push --branches origin", True),
    ("feature", "git push --mirror origin", True),
    ("feature", "git push origin :", True),
    ("feature", "git -c push.default=matching push", True),
    ("feature", "B=main; git push origin \"$B\"", True),
    ("feature", "git push origin \"$UNSET_BRANCH\"", True),
    ("feature", "git push \"$UNSET_REMOTE\" feature", True),
    # destructive pushes, any branch
    ("feature", "git push -f origin feature", True),
    ("feature", "git push -uf origin feature", True),
    ("feature", "git push --force-with-lease origin feature", True),
    ("feature", "git push --force-with-lease=feature:abc origin feature", True),
    ("feature", "git push --force-if-includes origin feature", True),
    ("feature", "git push origin +feature", True),
    ("feature", "git push --delete origin feature", True),
    ("feature", "git push -d origin feature", True),
    ("feature", "git push origin :feature", True),
    ("feature", "git push --prune origin 'refs/heads/*:refs/heads/*'", True),
    # tags
    ("feature", "git push --tags", True),
    ("feature", "git push --follow-tags origin feature", True),
    ("feature", "git push origin refs/tags/v1", True),
    ("feature", "git push origin tag v1", True),
    ("tagged", "git push origin v1.0", True),
    ("followtags", "git push origin feature", True),
    ("followtags", "git push --no-follow-tags origin feature", False),
    # no refspec: the current branch, its upstream, push.default, the remote's push refspecs
    ("feature", "git push", False),
    ("feature", "git push origin", False),
    ("nothing", "git push", False),
    ("pushspec-dev", "git push", False),
    ("main", "git push", True),
    ("master", "git push origin", True),
    ("up-main", "git push", True),
    ("current", "git push", True),
    ("matching", "git push origin", True),
    ("detached", "git push origin", True),
    ("pushspec", "git push", True),
    ("mirror", "git push origin", True),
    ("pushremote", "git push", True),
    ("plain", "git push", True),
    # where the push runs
    (None, "git -C {R}/feature push", False),
    ("main", "cd {R}/feature && git push", False),
    (None, "git -C {R}/main push", True),
    (None, "cd {R}/main && git push", True),
    (None, "cd \"$NOWHERE\" && git push origin feature", True),
    # any other repository: dev branches go, the rest asks
    ("other-repo", "git push origin feature", False),
    ("other-repo", "git push", False),
    ("other-url", "git push origin feature", False),
    (None, "git -C {R}/other-repo push -u origin feature", False),
    ("other-repo", "git push origin main", True),
    ("other-repo", "git push -f origin feature", True),
    ("other-repo", "git push --delete origin feature", True),
    ("other-repo", "git push origin --tags", True),
    ("other-url", "git push origin HEAD:master", True),
    ("feature", "git status && git log --oneline -3", False),
]


def selftest(rules_path=RULES_FILE):
    global SETTINGS, DESTRUCTIVE_FLAG
    import tempfile
    failures, total = [], 0
    # The rules (and their local addition with its own cases) also decide what counts as a launcher.
    rules = load_rules(rules_path)
    configure(rules)
    local = rules.get("selftest", {})
    with tempfile.TemporaryDirectory() as d:
        d = os.path.realpath(d)
        session = "selftest-session"
        scratch = os.path.join(d, "claude", session)
        os.makedirs(os.path.join(scratch, "build"))
        with open(os.path.join(scratch, "q.sql"), "w") as f:
            f.write("SELECT 1;\n")
        outside_dir = os.path.join(d, "outside")
        os.makedirs(outside_dir)
        with open(os.path.join(d, "run.sh"), "w") as f:
            f.write("#!/bin/bash\nset -e\nnice -n 5 node /p/scripts/codex-companion.mjs task x\n")
        with open(os.path.join(d, "ok.sh"), "w") as f:
            f.write("#!/bin/bash\n# Run `codex app-server` only through agent-worker.\necho codex exec is not run here\n"
                    "case $1 in claude|codex) echo $1 ;; esac\nrm -rf \"$tmp\"\nprint -r -- \"exec ${codex_bin} app-server $*\" > shim\n")
        with open(os.path.join(d, "spawn.py"), "w") as f:
            f.write("import subprocess\nsubprocess.run(['codex', 'exec', 'x'])\n")
        with open(os.path.join(d, "var.sh"), "w") as f:
            f.write("#!/bin/bash\ncomp=$HOME/p/scripts/codex-companion.mjs\nnode \"$comp\" task --json x\n")
        with open(os.path.join(d, "wipe.sh"), "w") as f:
            f.write(f"#!/bin/zsh\nrm -rf {outside_dir}/data\n")
        os.makedirs(os.path.join(d, "x/agent-worker-router/scripts"))
        with open(os.path.join(d, "x/agent-worker-router/scripts/agent-worker-router"), "w") as f:
            f.write("#!/bin/zsh\ncompanion=$root/scripts/codex-companion.mjs\nnode \"$companion\" task --json\n")
        with open(os.path.realpath(__file__)) as src, open(os.path.join(d, "guard-copy"), "w") as f:
            f.write(src.read())
        codex_cases = CODEX_CASES + [
            ("Bash", "x/agent-worker-router/scripts/agent-worker-router --worker codex -C . x", False),
            ("Bash", "bash var.sh", True), ("Bash", "bash run.sh", True), ("Bash", "./run.sh", True),
            ("Bash", f"zsh {d}/run.sh", True), ("Bash", "python3 spawn.py", True), ("Bash", "bash ok.sh", False),
            ("Bash", "./ok.sh", False),
            # The installed guard runs itself; a copy of it anywhere else is scanned like any script.
            ("Bash", "~/.local/bin/agent-worker-guard --selftest", False),
            ("Bash", "/usr/bin/python3 -IS ~/.local/bin/agent-worker-guard --all < event.json", False),
            ("Bash", f"python3 -IS {d}/guard-copy --selftest", True)] + [tuple(case) for case in local.get("codex", [])]
        for tool, data, deny in codex_cases:
            total += 1
            data = data if isinstance(data, dict) else {"command": data}
            got = decide_codex({"tool_name": tool, "tool_input": data, "cwd": d}, {})
            if bool(got) != deny:
                failures.append(f"codex {tool} {json.dumps(data, ensure_ascii=False)[:110]}: expected {'deny' if deny else 'allow'}")
        total += 1
        if decide_codex({"tool_name": "Bash", "tool_input": {"command": "codex exec x"}, "cwd": d}, {"AGENT_WORKER_GUARD": "off"}):
            failures.append("codex env off switch")
        for tool, data, deny in PROTECT_CASES:
            total += 1
            data = data if isinstance(data, dict) else {"command": data}
            if bool(protect({"tool_name": tool, "tool_input": data})) != deny:
                failures.append(f"protect {tool} {json.dumps(data)[:110]}: expected {'deny' if deny else 'allow'}")
        saved = SETTINGS, DESTRUCTIVE_FLAG
        SETTINGS = os.path.join(d, "config", "settings.json")
        DESTRUCTIVE_FLAG = os.path.join(d, "config", "allow-destructive")
        os.makedirs(os.path.join(d, "config"))
        with open(SETTINGS, "w") as f:
            json.dump(SETTINGS_FIXTURE, f, indent=2)
        try:
            for tool, data, deny in SETTINGS_CASES:
                total += 1
                data = data if isinstance(data, dict) else {"command": data}
                payload = json.dumps(data).replace("{SET}", SETTINGS).replace("{CFG}", os.path.dirname(SETTINGS)) \
                    .replace("{D}", d)
                if bool(protect({"tool_name": tool, "tool_input": json.loads(payload), "cwd": d})) != deny:
                    failures.append(f"settings {tool} {payload[:110]}: expected {'deny' if deny else 'allow'}")
            open(DESTRUCTIVE_FLAG, "w").close()
            total += 1
            if protect({"tool_name": "Write", "tool_input": {"file_path": SETTINGS, "content": "{}"}, "cwd": d}) or \
                    protect({"tool_name": "Bash", "tool_input": {"command": f"mv /tmp/s {SETTINGS}"}, "cwd": d}):
                failures.append("allow-destructive must open the settings to edits")
        finally:
            SETTINGS, DESTRUCTIVE_FLAG = saved
        # Local rules: a rule with a known id replaces it, the rest adds up; the file next to the rules is read.
        total += 1
        merged = {"bash": [{"id": "a", "why": "1"}], "mcp": [], "worker_deny_commands": ["x"],
                  "global_value_options": {"git": ["-C"]}}
        merge_rules(merged, {"bash": [{"id": "a", "why": "2"}, {"id": "b"}], "worker_deny_commands": ["x", "y"],
                             "global_value_options": {"git": ["-c"], "cli": ["--to"]}, "messages": {"protect": "p"},
                             "decision": "deny", "version": 9})
        os.makedirs(os.path.join(d, "merge"))
        with open(os.path.join(d, "merge", "destructive-rules.json"), "w") as f:
            json.dump({"bash": [{"id": "a"}], "mcp": []}, f)
        with open(os.path.join(d, "merge", LOCAL_RULES), "w") as f:
            json.dump({"bash": [{"id": "c"}]}, f)
        if [r.get("why") for r in merged["bash"]] != ["2", None] or merged["worker_deny_commands"] != ["x", "y"] or \
                merged["global_value_options"] != {"git": ["-C", "-c"], "cli": ["--to"]} or \
                merged["messages"] != {"protect": "p"} or merged["decision"] != "deny" or "version" in merged or \
                [r["id"] for r in load_rules(os.path.join(d, "merge", "destructive-rules.json"))["bash"]] != ["a", "c"]:
            failures.append("local rules merge")
        rules["scratchpad_globs"] = [os.path.join(d, "claude", "{session_id}")]
        test_rules = os.path.join(d, "rules.json")
        with open(test_rules, "w") as f:
            json.dump(rules, f)
        cases = [(c, False) for c in SAFE + local.get("safe", [])] + \
                [(c, True) for c in DESTRUCTIVE + local.get("destructive", [])] + [
            (f"bash {d}/wipe.sh", True), ("bash ok.sh", False), ("zsh " + os.path.join(d, "run.sh"), False)]
        for command, destructive in cases:
            total += 1
            command = command.replace("{S}", scratch).replace("{O}", outside_dir)
            event = {"tool_name": "Bash", "tool_input": {"command": command}, "cwd": d, "session_id": session,
                     "permission_mode": "bypassPermissions"}
            got = decide_destructive(event, {}, test_rules)
            if bool(got) != destructive:
                failures.append(f"destructive {command[:110]!r}: expected {'ask' if destructive else 'allow'}, got {got}")
        total += 1
        event = {"tool_name": "Bash", "tool_input": {"command": f"rm -rf {d}/pad/x"}, "cwd": d, "scratchpad_dir": f"{d}/pad"}
        if decide_destructive(event, {}, test_rules):
            failures.append("scratchpad_dir from the hook input must count as the scratchpad")
        for tool, data, destructive in MCP_CASES + [tuple(case) for case in local.get("mcp", [])]:
            total += 1
            got = decide_destructive({"tool_name": tool, "tool_input": data, "cwd": d}, {}, test_rules)
            if bool(got) != destructive:
                failures.append(f"mcp {tool} {json.dumps(data)[:90]}: expected {'ask' if destructive else 'allow'}, got {got}")
        repos, isolated = os.path.join(d, "repos"), ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "GIT_CEILING_DIRECTORIES")
        saved_env = {key: os.environ.get(key) for key in isolated}
        os.environ.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1", GIT_CEILING_DIRECTORIES=d)
        try:
            def git(*args):
                subprocess.run(["git", *args], check=True, capture_output=True, stdin=subprocess.DEVNULL)

            os.makedirs(os.path.join(repos, "plain"))
            git("init", "-q", "--bare", os.path.join(d, "remote.git"))
            for name, (branch, config) in GIT_REPOS.items():
                path = os.path.join(repos, name)
                git("init", "-q", "-b", branch, path)
                for key, value in [("remote.origin.url", os.path.join(d, "remote.git"))] + config:
                    git("-C", path, "config", key, value)
            with open(os.path.join(repos, "detached", ".git", "HEAD"), "w") as f:
                f.write("0" * 40 + "\n")
            git("-C", os.path.join(repos, "tagged"), "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q",
                "--allow-empty", "--no-verify", "-m", "t")
            git("-C", os.path.join(repos, "tagged"), "tag", "v1.0")
            for where, command, ask in GIT_PUSH_CASES + [tuple(case) for case in local.get("git_push", [])]:
                total += 1
                command = command.replace("{R}", repos)
                event = {"tool_name": "Bash", "tool_input": {"command": command}, "session_id": session,
                         "cwd": os.path.join(repos, where) if where else d}
                got = decide_destructive(event, {}, test_rules)
                if bool(got) != ask:
                    failures.append(f"git push in {where or '.'} {command[:90]!r}: expected {'ask' if ask else 'allow'}, "
                                    f"got {got}")
        finally:
            for key, value in saved_env.items():
                if value is None:
                    os.environ.pop(key, None)
                else:
                    os.environ[key] = value
        total += 1
        if decide_destructive({"tool_name": "Bash", "tool_input": {"command": "git push --force"}, "cwd": d},
                              {"AGENT_DESTRUCTIVE_GUARD": "off"}, test_rules):
            failures.append("destructive env off switch")
        total += 1
        broken = decide_destructive({"tool_name": "Bash", "tool_input": {"command": "ls"}, "cwd": d}, {},
                                    os.path.join(d, "missing.json"))
        if not broken or broken[0] != "warn":
            failures.append("unreadable rules must warn")
    for line in failures:
        print("FAIL", line)
    print(f"agent-worker-guard selftest: {total - len(failures)}/{total} OK "
          f"({len(SAFE)} safe commands, {len(DESTRUCTIVE)} destructive, {len(MCP_CASES)} MCP calls, "
          f"{len(SETTINGS_CASES)} settings edits, {len(GIT_PUSH_CASES)} git pushes; "
          f"{sum(len(v) for v in local.values() if isinstance(v, list))} cases from the local rules)")
    return 1 if failures else 0


def main():
    args = sys.argv[1:]
    if args[:1] == ["--selftest"]:
        return selftest(*args[1:2])
    try:
        event = json.load(sys.stdin)
        try:
            rules = load_rules()
            configure(rules)
        except (OSError, ValueError):
            rules = None  # the destructive policy says so to the user
        reason = protect(event)
        if reason:
            respond("deny", reason)
            return 0
        if args in ([], ["--all"]):
            reason = decide_codex(event, os.environ)
            if reason:
                respond("deny", reason)
                return 0
        if args in (["--destructive"], ["--all"]):
            verdict = decide_destructive(event, os.environ, rules=rules)
            if verdict:
                respond(*verdict)
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
