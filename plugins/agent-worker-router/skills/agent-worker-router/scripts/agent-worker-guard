# The guard's own settings. {SET} is a user settings file with the guard's hook entry, {CFG} its directory, {D} the
# working directory, whose .claude/ holds the project settings.
SETTINGS_FIXTURE = {
    "env": {"X": "1"},
    "permissions": {"allow": ["Bash(ls)"]},
    "hooks": {"PreToolUse": [{"matcher": "Bash|mcp__.*", "hooks": [
        {"type": "command", "command": "/u/.local/bin/agent-worker-guard --all", "timeout": 10}]}]},
}
SETTINGS_CASES = [
    ("Edit", {"file_path": "{SET}", "old_string": '"Bash(ls)"', "new_string": '"Bash(ls)", "Bash(pwd)"'}, False),
    ("Edit", {"file_path": "{SET}", "old_string": '"X": "1"', "new_string": '"X": "2"'}, False),
    ("Edit", {"file_path": "{SET}", "old_string": "not in the file", "new_string": "x"}, False),
    ("Write", {"file_path": "{SET}", "content": json.dumps(dict(SETTINGS_FIXTURE, permissions={}))}, False),
    ("Edit", {"file_path": "{SET}", "old_string": "/u/.local/bin/agent-worker-guard --all",
              "new_string": "/usr/bin/true"}, True),
