ROUTE_FLAGS = ("--confirm", "--native-prompt", "--reply")
# Route B: the user's whole message is the code of a request, alone or after one word of consent.
REPLY = re.compile(r"\W*(?:(?:guard|ok|ок|yes|да|code|код)\W+)?([0-9]{4})\W*", re.I)
# The IDE extension puts its own context before the user's words, under this heading.
IDE_REQUEST = "## My request for Codex:"
