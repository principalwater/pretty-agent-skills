def selftest(rules_path=RULES_FILE):
    global SETTINGS, DESTRUCTIVE_FLAG, CODEX_HOOKS, APPROVALS
    import tempfile
    failures, total = [], 0
    # The rules (and their local addition with its own cases) also decide what counts as a launcher.
    rules = load_rules(rules_path)
    configure(rules)
    local = rules.get("selftest", {})
    with tempfile.TemporaryDirectory() as d:
        d = os.path.realpath(d)
        session = "selftest-session"
        scratch = os.path.join(d, "claude", session)
        os.makedirs(os.path.join(scratch, "build"))
        with open(os.path.join(scratch, "q.sql"), "w") as f:
            f.write("SELECT 1;\n")
        outside_dir = os.path.join(d, "outside")
        os.makedirs(outside_dir)
        with open(os.path.join(d, "run.sh"), "w") as f:
            f.write("#!/bin/bash\nset -e\nnice -n 5 node /p/scripts/codex-companion.mjs task x\n")
        with open(os.path.join(d, "ok.sh"), "w") as f:
            f.write("#!/bin/bash\n# Run `codex app-server` only through agent-worker.\necho codex exec is not run here\n"
                    "case $1 in claude|codex) echo $1 ;; esac\nrm -rf \"$tmp\"\nprint -r -- \"exec ${codex_bin} app-server $*\" > shim\n")
        with open(os.path.join(d, "spawn.py"), "w") as f:
            f.write("import subprocess\nsubprocess.run(['codex', 'exec', 'x'])\n")
        with open(os.path.join(d, "var.sh"), "w") as f:
            f.write("#!/bin/bash\ncomp=$HOME/p/scripts/codex-companion.mjs\nnode \"$comp\" task --json x\n")
        with open(os.path.join(d, "wipe.sh"), "w") as f:
            f.write(f"#!/bin/zsh\nrm -rf {outside_dir}/data\n")
        # Stale copies a careless reading would trust: a query file named by a number, one outside the scratchpad.
        with open(os.path.join(scratch, "1"), "w") as f:
            f.write("SELECT 1;\n")
        with open(os.path.join(outside_dir, "drop.sql"), "w") as f:
            f.write("DROP TABLE t;\n")
        with open(os.path.join(d, "rewrite.sh"), "w") as f:
            f.write("#!/bin/bash\necho 'DROP TABLE t' > q2.sql\npython3 -c 'print(open(\"q2.sql\").read())'\n"
                    "clickhouse client --queries-file q2.sql\n")
        os.makedirs(os.path.join(d, "x/agent-worker-router/scripts"))
        with open(os.path.join(d, "x/agent-worker-router/scripts/agent-worker-router"), "w") as f:
            f.write("#!/bin/zsh\ncompanion=$root/scripts/codex-companion.mjs\nnode \"$companion\" task --json\n")
        with open(os.path.realpath(__file__)) as src, open(os.path.join(d, "guard-copy"), "w") as f:
            f.write(src.read())
        codex_cases = CODEX_CASES + [
            ("Bash", "x/agent-worker-router/scripts/agent-worker-router --worker codex -C . x", False),
            ("Bash", "bash var.sh", True), ("Bash", "bash run.sh", True), ("Bash", "./run.sh", True),
            ("Bash", f"zsh {d}/run.sh", True), ("Bash", "python3 spawn.py", True), ("Bash", "bash ok.sh", False),
            ("Bash", "./ok.sh", False),
            # The installed guard runs itself; a copy of it anywhere else is scanned like any script.
            ("Bash", "~/.local/bin/agent-worker-guard --selftest", False),
            ("Bash", "/usr/bin/python3 -IS ~/.local/bin/agent-worker-guard --all < event.json", False),
            ("Bash", f"python3 -IS {d}/guard-copy --selftest", True)] + [tuple(case) for case in local.get("codex", [])]
        for tool, data, deny in codex_cases:
            total += 1
            data = data if isinstance(data, dict) else {"command": data}
            got = decide_codex({"tool_name": tool, "tool_input": data, "cwd": d}, {})
            if bool(got) != deny:
                failures.append(f"codex {tool} {json.dumps(data, ensure_ascii=False)[:110]}: expected {'deny' if deny else 'allow'}")
        total += 1
        if decide_codex({"tool_name": "Bash", "tool_input": {"command": "codex exec x"}, "cwd": d}, {"AGENT_WORKER_GUARD": "off"}):
            failures.append("codex env off switch")
        for tool, data, deny in PROTECT_CASES:
            total += 1
            data = data if isinstance(data, dict) else {"command": data}
            if bool(protect({"tool_name": tool, "tool_input": data})) != deny:
                failures.append(f"protect {tool} {json.dumps(data)[:110]}: expected {'deny' if deny else 'allow'}")
        saved = SETTINGS, DESTRUCTIVE_FLAG, CODEX_HOOKS
        SETTINGS = os.path.join(d, "config", "settings.json")
        DESTRUCTIVE_FLAG = os.path.join(d, "config", "allow-destructive")
        CODEX_HOOKS = os.path.join(d, "codex", "hooks.json")
        os.makedirs(os.path.join(d, "config"))
        os.makedirs(os.path.join(d, "codex"))
        with open(SETTINGS, "w") as f:
            json.dump(SETTINGS_FIXTURE, f, indent=2)
        with open(CODEX_HOOKS, "w") as f:
            json.dump({"hooks": SETTINGS_FIXTURE["hooks"]}, f, indent=2)
        try:
            # Codex: its hooks.json registers the guard as the Claude settings do; apply_patch is its file edit.
            patch = "*** Begin Patch\n*** Update File: {}\n@@\n-x\n+y\n*** End Patch"
            for tool, data, deny in [
                    ("Write", {"file_path": CODEX_HOOKS, "content": "{}"}, True),
                    ("Write", {"file_path": CODEX_HOOKS, "content": json.dumps({"hooks": SETTINGS_FIXTURE["hooks"]})}, False),
                    ("apply_patch", {"command": patch.format(CODEX_HOOKS)}, True),
                    ("apply_patch", {"command": patch.format(SETTINGS)}, True),
                    ("apply_patch", {"command": patch.format(os.path.join(d, "codex", "destructive-rules.json"))}, True),
                    ("apply_patch", {"command": patch.format(os.path.join(d, "notes.md"))}, False),
                    ("Bash", {"command": f"mv /tmp/h {CODEX_HOOKS}"}, True),
                    ("Bash", {"command": f"cp /tmp/hooks.json {os.path.dirname(CODEX_HOOKS)}/"}, True),
                    ("Bash", {"command": f"cat {CODEX_HOOKS}"}, False),
                    ("Bash", {"command": f"jq . {os.path.join(d, 'plugin', 'hooks.json')}"}, False)]:
                total += 1
                if bool(protect({"tool_name": tool, "tool_input": data, "cwd": d})) != deny:
                    failures.append(f"codex settings {tool} {json.dumps(data)[:110]}: expected {'deny' if deny else 'allow'}")
            for tool, data, deny in SETTINGS_CASES:
                total += 1
                data = data if isinstance(data, dict) else {"command": data}
                payload = json.dumps(data).replace("{SET}", SETTINGS).replace("{CFG}", os.path.dirname(SETTINGS)) \
                    .replace("{D}", d)
                if bool(protect({"tool_name": tool, "tool_input": json.loads(payload), "cwd": d})) != deny:
                    failures.append(f"settings {tool} {payload[:110]}: expected {'deny' if deny else 'allow'}")
            open(DESTRUCTIVE_FLAG, "w").close()
            total += 1
            if protect({"tool_name": "Write", "tool_input": {"file_path": SETTINGS, "content": "{}"}, "cwd": d}) or \
                    protect({"tool_name": "Bash", "tool_input": {"command": f"mv /tmp/s {SETTINGS}"}, "cwd": d}):
                failures.append("allow-destructive must open the settings to edits")
        finally:
            SETTINGS, DESTRUCTIVE_FLAG, CODEX_HOOKS = saved
        # Local rules: a rule with a known id replaces it, the rest adds up; the file next to the rules is read.
        total += 1
        merged = {"bash": [{"id": "a", "why": "1"}], "mcp": [], "worker_deny_commands": ["x"],
                  "global_value_options": {"git": ["-C"]}}
        merge_rules(merged, {"bash": [{"id": "a", "why": "2"}, {"id": "b"}], "worker_deny_commands": ["x", "y"],
                             "global_value_options": {"git": ["-c"], "cli": ["--to"]}, "messages": {"protect": "p"},
                             "decision": "deny", "version": 9})
        os.makedirs(os.path.join(d, "merge"))
        with open(os.path.join(d, "merge", "destructive-rules.json"), "w") as f:
            json.dump({"bash": [{"id": "a"}], "mcp": []}, f)
        with open(os.path.join(d, "merge", LOCAL_RULES), "w") as f:
            json.dump({"bash": [{"id": "c"}]}, f)
        if [r.get("why") for r in merged["bash"]] != ["2", None] or merged["worker_deny_commands"] != ["x", "y"] or \
                merged["global_value_options"] != {"git": ["-C", "-c"], "cli": ["--to"]} or \
                merged["messages"] != {"protect": "p"} or merged["decision"] != "deny" or "version" in merged or \
                [r["id"] for r in load_rules(os.path.join(d, "merge", "destructive-rules.json"))["bash"]] != ["a", "c"]:
            failures.append("local rules merge")
        rules["scratchpad_globs"] = [os.path.join(d, "claude", "{session_id}")]
        # A script that is itself a watched command: the rules judge its calls, its code is not scanned. The same
        # file anywhere else is a script like any other, and the `sudo` in its function is found.
        tool = "#!/usr/bin/env zsh\n_setup() { sudo true; }\nyt() { _setup; command yt \"$@\"; }\n" \
               "git() { rm -rf " + outside_dir + "/data; }\n" \
               "[[ \"$ZSH_EVAL_CONTEXT\" == toplevel ]] && { yt \"$@\"; exit $?; }\n"
        for folder in ("tool", "other"):
            os.makedirs(os.path.join(d, folder))
            with open(os.path.join(d, folder, "yt"), "w") as f:
                f.write(tool)
        rules["tool_scripts"] = rules.get("tool_scripts", []) + [os.path.join(d, "tool", "yt")]
        # The built-in tables hold for the default settings, the local rules' own cases for the settings they chose.
        test_rules, plain_rules, narrow_rules = (os.path.join(d, name) for name in ("rules.json", "plain.json", "narrow.json"))
        for path, settings in ((test_rules, {}), (plain_rules, {"sql_ask": None, "unknown_sql_decision": None}),
                               (narrow_rules, {"sql_ask": "destructive", "unknown_sql_decision": "deny"})):
            with open(path, "w") as f:
                json.dump({k: v for k, v in {**rules, **settings}.items() if v is not None}, f)
        cases = [(c, False, plain_rules) for c in SAFE] + [(c, True, plain_rules) for c in DESTRUCTIVE] + \
                [(c, False, test_rules) for c in local.get("safe", [])] + \
                [(c, True, test_rules) for c in local.get("destructive", [])] + \
                [(c, False, narrow_rules) for c in ADDS] + [(c, True, narrow_rules) for c in REMOVES] + [
            (f"bash {d}/wipe.sh", True, plain_rules), ("bash ok.sh", False, plain_rules),
            # In a script too: what a file held before the script rewrote it is still a write.
            (f"bash {d}/rewrite.sh", True, plain_rules),
            # Only the function named like the tool script is the tool; another watched name in it is read as usual.
            (f"source {d}/tool/yt; git status", True, plain_rules),
            ("zsh " + os.path.join(d, "run.sh"), False, plain_rules),
            (f"source {d}/tool/yt; yt list //home", False, plain_rules),
            (f"source {d}/tool/yt; yt remove //x", True, plain_rules),
            (f"{d}/tool/yt list //home", False, plain_rules), (f"{d}/tool/yt remove //x", True, plain_rules),
            (f"zsh {d}/tool/yt list //home", False, plain_rules), (f"zsh {d}/tool/yt remove //x", True, plain_rules),
            (f"source {d}/tool/yt; _setup", True, plain_rules),
            # Redefined after the tool script was sourced, the name is an ordinary function again.
            (f"source {d}/tool/yt; yt() {{ rm -rf {outside_dir}/data; }}; yt list //home", True, plain_rules),
            (f"source {d}/other/yt; yt list //home", True, plain_rules)]
        for command, destructive, rules_file in cases:
            total += 1
            command = command.replace("{S}", scratch).replace("{O}", outside_dir)
            event = {"tool_name": "Bash", "tool_input": {"command": command}, "cwd": d, "session_id": session,
                     "permission_mode": "bypassPermissions"}
            got = decide_destructive(event, {}, rules_file)
            if bool(got) != destructive:
                failures.append(f"destructive {command[:110]!r}: expected {'ask' if destructive else 'allow'}, got {got}")
        total += 1
        event = {"tool_name": "Bash", "tool_input": {"command": f"rm -rf {d}/pad/x"}, "cwd": d, "scratchpad_dir": f"{d}/pad"}
        if decide_destructive(event, {}, test_rules):
            failures.append("scratchpad_dir from the hook input must count as the scratchpad")
        # A query the guard cannot read: asked about by default, refused with the way out when the rules say so.
        total += 1
        event = {"tool_name": "Bash", "tool_input": {"command": 'clickhouse client -q "$Q"'}, "cwd": d}
        if [v and v[0] for v in (decide_destructive(event, {}, plain_rules), decide_destructive(event, {}, narrow_rules))] \
                != ["ask", "deny"]:
            failures.append("an unreadable query must ask by default and be refused under unknown_sql_decision deny")
        # Harnesses: Codex cannot honor "ask" from a hook, so a match is a refusal there (named, or told by turn_id).
        total += 1
        event = {"tool_name": "Bash", "tool_input": {"command": f"rm -rf {outside_dir}/x"}, "cwd": d}
        if [v and v[0] for v in (decide_destructive(normalize(event, "claude"), {}, plain_rules),
                                 decide_destructive(normalize(event), {}, plain_rules),
                                 decide_destructive(normalize(event, "codex"), {}, plain_rules),
                                 decide_destructive(normalize(dict(event, turn_id="t"), None), {}, plain_rules),
                                 decide_destructive(normalize(event, "other"), {}, plain_rules))] \
                != ["ask", "ask", "deny", "deny", "deny"]:
            failures.append("harness: ask under Claude Code, a refusal under Codex and under a harness not listed")
        # Approval under Codex. The store of the test is the one a guard started with this home would use, so the
        # wrapper, run as a process of its own, reads what the hook functions wrote.
        home = os.path.join(d, "home")
        saved_store, APPROVALS = APPROVALS, os.path.join(home, ".config", "agent-worker-router", "guard-approvals")
        # The guard of these cases is the copy in the test directory: a path Codex reads as a plain word.
        saved_argv, sys.argv[0] = sys.argv[0], os.path.join(d, "guard-copy")
        try:
            def codex(tool, data, mode, routes, session="s1"):
                return normalize({"tool_name": tool, "tool_input": data, "cwd": d, "session_id": session,
                                  "permission_mode": mode, "turn_id": "t"}, "codex", routes)

            def shell(line):
                return subprocess.run(["/bin/sh", "-c", line], env={"HOME": home, "PATH": os.defpath},
                                      capture_output=True, text=True, stdin=subprocess.DEVNULL)

            os.chmod(sys.argv[0], 0o755)
            # Route A: a shell call becomes `guard --confirm RULE TOKEN && eval 'command'` where Codex can ask,
            # the command in one word whatever it holds; Codex's request is noted; --confirm succeeds once and
            # only with that note, so without it the shell never reaches the command.
            wipe = f"rm -rf {outside_dir}/x; echo 'it'\"'\"'s' \"$HOME\" $(date)\n# done"
            total += 1
            got = decide_destructive(codex("Bash", {"command": wipe}, "default", ["prompt", "reply"]), {}, plain_rules)
            line = got[1]["command"] if got and got[0] == "rewrite" else ""
            if not got or got[0] != "rewrite" or (confirm_words(line) or ("", ""))[1] != wipe or \
                    not re.fullmatch(re.escape(sys.argv[0]) + r" --confirm rm-recursive [0-9a-f]{12} && eval '.*'", line, re.S):
                failures.append(f"route A: a shell call must become the confirm line holding the command, got {got}")
            total += 1
            sys.argv[0] = os.path.join(d, "with space", "guard-copy")
            spaced = decide_destructive(codex("Bash", {"command": wipe}, "default", ["prompt"]), {}, plain_rules)
            sys.argv[0] = os.path.join(d, "guard-copy")
            if not spaced or spaced[0] != "deny":
                failures.append("route A: a guard path that Codex would not read as a plain word must not be rewritten to")
            total += 1
            if [v and v[0] for v in (
                    decide_destructive(codex("Bash", {"command": wipe}, "bypassPermissions", ["prompt"]), {}, plain_rules),
                    decide_destructive(codex("Bash", {"command": wipe}, None, ["prompt"]), {}, plain_rules),
                    decide_destructive(codex("Bash", {"command": wipe}, "default", []), {}, plain_rules),
                    decide_destructive(codex("mcp__clickhouse__run_query", {"query": "DROP TABLE t"}, "default",
                                             ["prompt"]), {}, plain_rules))] != ["deny"] * 4:
                failures.append("route A: no rewrite when Codex cannot ask, without the flag, or for a tool that is not the shell")
            total += 1
            ran = confirm_line("test-rule", "0123456789ab", "echo ran; echo \"it's $0\" >/dev/null")
            before = shell(ran)
            for command in (ran + " && echo more", ran.replace("--confirm", "--other"), "echo ran", " " + ran,
                            ran.replace(guard_path(), "/bin/echo"), ran.replace("&& eval", "; eval"),
                            ran.replace("&& eval", "|| eval"), ran.replace("0123456789ab", "0123456789AB")):
                note_asked({"tool_name": "Bash", "tool_input": {"command": command}})
            unnoted = shell(ran)
            note_asked({"tool_name": "Write", "tool_input": {"command": ran}})
            wrong_tool = shell(ran)
            note_asked({"tool_name": "Bash", "tool_input": {"command": ran}})
            other = shell(confirm_line("test-rule", "ba9876543210", "echo ran"))
            once = shell(ran)
            twice = shell(ran)
            if [(run.returncode, run.stdout) for run in (before, unnoted, wrong_tool, other, once, twice)] != \
                    [(CONFIRM_REFUSED, "")] * 4 + [(0, "ran\n"), (CONFIRM_REFUSED, "")]:
                runs = (before, unnoted, wrong_tool, other, once, twice)
                failures.append("route A: the command runs once, only after Codex asked about that very line: "
                                f"{[(run.returncode, run.stdout, run.stderr[:80]) for run in runs]}")
            # A note counts for a while: a question nobody answered is not a standing permission.
            total += 1
            note_asked({"tool_name": "Bash", "tool_input": {"command": ran}})
            aged = time.time() - ASKED_TTL - 5
            os.utime(os.path.join(APPROVALS, "0123456789ab.asked"), (aged, aged))
            stale = shell(ran)
            drop("0123456789ab.asked")
            if (stale.returncode, stale.stdout) != (CONFIRM_REFUSED, ""):
                failures.append(f"route A: a note older than the guard keeps must not confirm, got {stale.returncode}")
            # Route B: a refusal that names a code; the user's own message that is just that code allows the same
            # call, once, in the session that asked, for a while.
            push, both = {"command": "git push --force origin main"}, ["prompt", "reply"]

            def refused(session="s1", data=push, tool="Bash"):
                got = decide_destructive(codex(tool, data, "bypassPermissions", both, session), {}, plain_rules)
                names = sorted(n for n in os.listdir(APPROVALS) if n.endswith(".json")) if os.path.isdir(APPROVALS) else []
                return got, names

            def says(prompt, session="s1", **more):
                return note_reply(dict({"hook_event_name": "UserPromptSubmit", "prompt": prompt,
                                        "session_id": session}, **more))

            def clear():
                for name in os.listdir(APPROVALS):
                    drop(name)

            total += 1
            got, names = refused()
            again, names_again = refused()
            code = names[0][:-5] if len(names) == 1 else ""
            if not got or got[0] != "deny" or not re.fullmatch(r"[0-9]{4}", code) or code not in got[1] \
                    or "git push --force origin main" not in got[1] or names != names_again or again != got \
                    or (stored(code + ".json") or {}).get("state") != "pending":
                failures.append(f"route B: a refusal names one code and keeps it for the same call, got {got} {names}")
            total += 1
            silent = [says(f"no {code}"), says(f"{code} and the rest"), says("%04d" % ((int(code or 0) + 1) % 10000)),
                      says(code + "1"), says(""), says(code, session="s2"), says(code, session=""),
                      says(code, agent_id="a1"), says(code, agent_type="worker"),
                      says(f"> To allow it once, reply:\n> {code}")]
            if any(silent) or (stored(code + ".json") or {}).get("state") != "pending" or refused()[0] is None:
                failures.append("route B: only the user's own message that is just the code, in the session that "
                                f"asked, counts: {silent}")
            total += 1
            results = []
            for form in ("{}", " {}\n", "`{}`", "да {}", "OK, {}.", "guard {}", "Код: {}",
                         "# Context from my IDE setup:\n\n## Active file: a.py\n\n" + IDE_REQUEST + "\n{}"):
                clear()
                code = refused()[1][0][:-5]
                done = says(form.format(code))
                first, second = refused()[0], refused()[0]
                results.append(bool(done) and "git push --force origin main" in done and first is None
                               and bool(second) and second[0] == "deny")
            if not all(results):
                failures.append(f"route B: the user's code allows the same call once, however they wrap it: {results}")
            total += 1
            clear()
            code = refused()[1][0][:-5]
            says(code)
            elsewhere = refused(session="s2")[0]
            different = refused(data={"command": "git push --force origin main "})[0]
            approved = stored(code + ".json") or {}
            store(code + ".json", dict(approved, until=time.time() - 1))
            late, names = refused()
            next_code = next((n[:-5] for n in names for r in [stored(n) or {}] if r.get("state") == "pending"
                              and r.get("session") == "s1" and r.get("key") == approved.get("key")), "")
            if not (elsewhere and different and late) or approved.get("state") != "approved" or not next_code \
                    or not says(next_code) or refused()[0] is not None:
                failures.append("route B: an approval is for the same call, the same session and a few minutes, and "
                                "one that ran out does not stand in the way of the next")
            # A long call keeps its start and its end, and says how much it leaves out.
            total += 1
            clear()
            long_call = "git push --force origin main " + "x" * 3000 + " the-end"
            got = refused(data={"command": long_call})[0]
            left_out = text("cut", count=len(long_call) - SHOWN_CALL * 3 // 4 - SHOWN_CALL // 4)
            if not got or "the-end" not in got[1] or left_out not in got[1] or "x" * (SHOWN_CALL + 1) in got[1]:
                failures.append(f"route B: a long call is shown by its start and its end, got {str(got)[:200]}")
            # The routes together: the shell goes to Codex's own prompt where it can ask, anything else to the code.
            total += 1
            if [v and v[0] for v in (
                    decide_destructive(codex("Bash", push, "default", both), {}, plain_rules),
                    decide_destructive(codex("Bash", push, "bypassPermissions", both), {}, plain_rules),
                    decide_destructive(codex("mcp__clickhouse__run_query", {"query": "DROP TABLE t"}, "default",
                                             both), {}, plain_rules),
                    decide_destructive(codex("Bash", {"command": "ls"}, "default", both), {}, plain_rules))] \
                    != ["rewrite", "deny", "deny", None]:
                failures.append("routes: the native prompt for the shell where Codex can ask, the code otherwise")
            # Whatever the rules name as the decision, a harness that cannot ask refuses; Claude Code asks with the
            # routes switched on as it does without them.
            total += 1
            loaded = load_rules(plain_rules)
            odd = [decide_destructive(codex("Bash", push, "bypassPermissions", both), {},
                                      rules=dict(loaded, decision=value)) for value in ("allow", "Ask", "deny")]
            asks = decide_destructive(normalize({"tool_name": "Bash", "tool_input": push, "cwd": d}, "claude", both),
                                      {}, plain_rules)
            if [v and v[0] for v in odd] != ["deny"] * 3 or not asks or asks[0] != "ask":
                failures.append(f"routes: an odd decision in the rules is a refusal under Codex, and Claude Code asks: {odd} {asks}")
            # A refusal without words would be no refusal to Codex.
            total += 1
            saved_text, MESSAGES["protect"] = MESSAGES["protect"], "  "
            blank = text("protect")
            MESSAGES["protect"] = saved_text
            if blank != DEFAULT_MESSAGES["protect"]:
                failures.append("messages: a blank replacement must fall back to the built-in text")
            # No session, or a store that cannot be written, leaves the plain refusal, never an open call.
            total += 1
            plain = decide_destructive(codex("Bash", push, "bypassPermissions", []), {}, plain_rules)
            nameless = decide_destructive(codex("Bash", push, "bypassPermissions", both, session=""), {}, plain_rules)
            clear()
            os.rmdir(APPROVALS)
            with open(APPROVALS, "w") as f:
                f.write("not a directory")
            broken = decide_destructive(codex("Bash", push, "bypassPermissions", ["reply"]), {}, plain_rules)
            os.unlink(APPROVALS)
            if not plain or plain[0] != "deny" or nameless != plain or broken != plain:
                failures.append(f"routes: no session or a broken store must leave the plain refusal, got {nameless} {broken}")
        except Exception as error:  # a broken route must show as a failed case, not end the run
            total += 1
            failures.append(f"approval routes: {type(error).__name__}: {error}")
        finally:
            APPROVALS, sys.argv[0] = saved_store, saved_argv
        for tool, data, destructive, rules_file in \
                [(*case, plain_rules) for case in MCP_CASES] + [(*case, test_rules) for case in local.get("mcp", [])] + [
                    ("mcp__clickhouse__run_query", {"query": "INSERT INTO t VALUES (1)"}, False, narrow_rules),
                    ("mcp__clickhouse__run_query", {"query": "DROP TABLE t"}, True, narrow_rules)]:
            total += 1
            got = decide_destructive({"tool_name": tool, "tool_input": data, "cwd": d}, {}, rules_file)
            if bool(got) != destructive:
                failures.append(f"mcp {tool} {json.dumps(data)[:90]}: expected {'ask' if destructive else 'allow'}, got {got}")
        # when.matches reads each string of the field once ignore has cut its fragments out; a condition that
        # cannot be evaluated keeps the rule matching.
        total += 1
        probe, deep = {"field": "a.b", "matches": "x", "ignore": "<x>"}, "y"
        for _ in range(5000):
            deep = [deep]
        if [mcp_rule({"tool": "^t$", "when": when}, "t", {"a": {"b": value}}, {}) for value, when in (
                (["<x>", {"c": "x"}], probe), ("<x> y", probe), (["x<", ">"], dict(probe, matches="<>")), (deep, probe),
                ("xx", dict(probe, matches="xx", ignore="")), ("y", dict(probe, matches="(")),
                ("y", dict(probe, ignore="(")), ("y", dict(probe, matches="x{4294967296}")),
                ("y", dict(probe, matches=None)), ("y", dict(probe, field=42)), ("y", 42),
                (42, dict(probe, matches="(")), (42, dict(probe, ignore="(")))] \
                != [True, False, False, False, True, True, True, True, True, True, True, True, True] or \
                not mcp_rule({"tool": "^t$", "sql_field": 42}, "t", {"a": 1}, {}):
            failures.append("when.matches: each string of the field, ignore cut out first; a broken condition matches")
        repos, isolated = os.path.join(d, "repos"), ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "GIT_CEILING_DIRECTORIES")
        saved_env = {key: os.environ.get(key) for key in isolated}
        os.environ.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1", GIT_CEILING_DIRECTORIES=d)
        try:
            def git(*args):
                subprocess.run(["git", *args], check=True, capture_output=True, stdin=subprocess.DEVNULL)

            os.makedirs(os.path.join(repos, "plain"))
            git("init", "-q", "--bare", os.path.join(d, "remote.git"))
            for name, (branch, config) in GIT_REPOS.items():
                path = os.path.join(repos, name)
                git("init", "-q", "-b", branch, path)
                for key, value in [("remote.origin.url", os.path.join(d, "remote.git"))] + config:
                    git("-C", path, "config", key, value)
            with open(os.path.join(repos, "detached", ".git", "HEAD"), "w") as f:
                f.write("0" * 40 + "\n")
            git("-C", os.path.join(repos, "tagged"), "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q",
                "--allow-empty", "--no-verify", "-m", "t")
            git("-C", os.path.join(repos, "tagged"), "tag", "v1.0")
            for where, command, ask in GIT_PUSH_CASES + [tuple(case) for case in local.get("git_push", [])]:
                total += 1
                command = command.replace("{R}", repos)
                event = {"tool_name": "Bash", "tool_input": {"command": command}, "session_id": session,
                         "cwd": os.path.join(repos, where) if where else d}
                got = decide_destructive(event, {}, test_rules)
                if bool(got) != ask:
                    failures.append(f"git push in {where or '.'} {command[:90]!r}: expected {'ask' if ask else 'allow'}, "
                                    f"got {got}")
            path = os.path.join(repos, "feature")
            dest = "https://github.com/example/test.git"
            git("-C", path, "config", "remote.origin.pushurl", dest)
            git("-C", path, "config", "remote.other.url", dest.replace("example/", "other/"))
            scope = {"url": dest, "branch_prefix": "codex/"}
            public = {"id": "git-push-public", "why": "public remote", "command": ["git"], "sub": ["push"], "push_url_regex": r"github\.com",
                      "approved_push": scope}
            scoped_rules = dict(rules, bash=[public] + [r for r in rules["bash"] if r.get("id") != public["id"]])
            ref = "1" * 40 + ":refs/heads/codex/topic"
            def check_push(command, ask):
                nonlocal total
                total += 1
                event = {"tool_name": "Bash", "tool_input": {"command": command}, "cwd": path}
                if bool(decide_destructive(event, {}, rules=scoped_rules)) != ask:
                    failures.append(f"scoped public push: {command!r}, expected ask={ask}")
            for args, ask in [(f"origin {ref}", False), (f"--atomic origin {ref} {ref}-2", False),
                              (f"other {ref}", True), ("origin HEAD", True), (f"origin {ref} HEAD:main", True),
                              (f"--force origin {ref}", True), (f"--tags origin {ref}", True),
                              (f"origin +{ref}", True), ("origin :refs/heads/codex/topic", True),
                              (f"origin {ref.replace('codex/', 'fix/')}", True)]:
                check_push(f"git push {args}", ask)
            git("-C", path, "config", "--add", "remote.origin.pushurl", dest.replace("example/", "other/"))
            check_push(f"git push origin {ref}", True)
        finally:
            for key, value in saved_env.items():
                if value is None:
                    os.environ.pop(key, None)
                else:
                    os.environ[key] = value
        total += 1
        if decide_destructive({"tool_name": "Bash", "tool_input": {"command": "git push --force"}, "cwd": d},
                              {"AGENT_DESTRUCTIVE_GUARD": "off"}, test_rules):
            failures.append("destructive env off switch")
        total += 1
        broken = decide_destructive({"tool_name": "Bash", "tool_input": {"command": "ls"}, "cwd": d}, {},
                                    os.path.join(d, "missing.json"))
        if not broken or broken[0] != "warn":
            failures.append("unreadable rules must warn")
    for line in failures:
        print("FAIL", line)
    print(f"agent-worker-guard selftest: {total - len(failures)}/{total} OK "
          f"({len(SAFE)} safe commands, {len(DESTRUCTIVE)} destructive, {len(ADDS) + len(REMOVES)} for sql_ask, "
          f"{len(MCP_CASES)} MCP calls, "
          f"{len(SETTINGS_CASES)} settings edits, {len(GIT_PUSH_CASES)} git pushes; "
          f"{sum(len(v) for v in local.values() if isinstance(v, list))} cases from the local rules)")
    return 1 if failures else 0


def main():
    args = sys.argv[1:]
    if args[:1] == ["--selftest"]:
        return selftest(*args[1:2])
    if args[:1] == ["--confirm"]:
        try:
            configure(load_rules())
        except (OSError, ValueError):
            pass
        return confirm(*args[1:]) if len(args) == 3 else 2
    harness = None
    if "--harness" in args:
        k = args.index("--harness")
        harness = (args[k + 1:k + 2] or [None])[0]
        del args[k:k + 2]
    routes = [route for route, flag in (("prompt", "--native-prompt"), ("reply", "--reply")) if flag in args]
    # --question: the flag of a route that is gone; an entry that still carries it keeps its policy.
    args = [arg for arg in args if arg not in ("--native-prompt", "--reply", "--question")]
    try:
        event = normalize(json.load(sys.stdin), harness, routes)
        try:
            rules = load_rules()
            configure(rules)
        except (OSError, ValueError):
            rules = None  # the destructive policy says so to the user
        # One command line serves every event of a harness that names them; the routes own two of them.
        happened = event.get("hook_event_name") or "PreToolUse"
        if happened == "PermissionRequest":
            if event["harness"].get("prompt"):
                note_asked(event)
            return 0
        if happened == "UserPromptSubmit":
            said = note_reply(event) if event["harness"].get("reply") else None
            if said:
                json.dump({"systemMessage": said, "hookSpecificOutput": {
                    "hookEventName": "UserPromptSubmit", "additionalContext": said}}, sys.stdout, ensure_ascii=False)
            return 0
        if happened != "PreToolUse":
            return 0
        reason = protect(event)
        if reason:
            respond("deny", reason)
            return 0
        if args in ([], ["--all"]):
            reason = decide_codex(event, os.environ)
            if reason:
                respond("deny", reason)
                return 0
        if args in (["--destructive"], ["--all"]):
            verdict = decide_destructive(event, os.environ, rules=rules)
            if verdict:
                respond(*verdict)
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
