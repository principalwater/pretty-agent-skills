#!/bin/zsh
# Fresh external workers. This is not a native host subagent or a security sandbox.
set -euo pipefail
umask 077

usage() { print 'usage: agent-worker-router --worker deepseek|claude|codex -C DIR [--access read|edit|full] [--model MODEL] [--effort LEVEL] [--provider ID] [--via plugin|cli] [--pro] [--evidence FILE] [--timeout SEC] [--keep] [--resume SESSION_ID] [--lease FILE] [--lease-wait SEC] BRIEF|-'; }
die() { print -u2 -- "agent-worker-router: $1"; exit ${2:-1}; }
limit_time() { print -- "$(date -r "$1" '+%Y-%m-%d %H:%M %Z') (~$(( ($1 - $(date +%s) + 59) / 60 ))m)"; }

valid_model() { [[ $1 =~ '^[A-Za-z0-9]([A-Za-z0-9_.:-]|\[|\])*$' ]]; }
valid_provider() { [[ $1 =~ '^[A-Za-z0-9_-]+$' ]]; }
valid_effort() { [[ -n $1 && $1 != *[[:space:]]* && " $efforts " == *" $1 "* ]]; }
warn() { print -ru2 -- "agent-worker-router: warning: $1"; }
run_worker() {
  perl -e '
    use strict;
    use warnings;
    my ($file, $wait, $timeout, $started) = splice @ARGV, 0, 4;
    my $lease;
    if (length $file) {
      open $lease, ">>", $file or do { warn "lease $file: $!\n"; exit 78 };
      $SIG{ALRM} = sub { warn "lease wait timed out: $file\n"; exit 76 };
      alarm $wait;
      flock $lease, 2 or do { warn "lease $file: $!\n"; exit 78 };
      alarm 0;
    }
    open my $receipt, ">", $started or do { warn "launch marker: $!\n"; exit 78 };
    my $pid = fork;
    defined $pid or do { warn "fork: $!\n"; exit 78 };
    if (!$pid) {
      $SIG{ALRM} = "DEFAULT";
      alarm $timeout;
      # Perl closes the lease fd on exec so worker daemons cannot retain it.
      exec @ARGV or die "exec: $!\n";
    }
    print $receipt "1\n";
    close $receipt;
    waitpid $pid, 0;
    exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
  ' "$lease" "$lease_wait" "$1" "$launch_file" "${@:2}"
}

worker= dir= model= effort= provider= evidence= timeout=300 access=read pro=0 keep=0 resume= via=
model_given=0 effort_given=0 provider_given=0 ran=0 route=cli thread=
lease=${AGENT_WORKER_ROUTER_LEASE:-} lease_wait=${AGENT_WORKER_ROUTER_LEASE_WAIT:-900}
while (( $# )); do
  case $1 in
    --worker|-C|--model|--effort|--provider|--via|--evidence|--timeout|--access|--resume|--lease|--lease-wait)
      (( $# >= 2 )) || die "$1 requires an argument" 2
      case $1 in
        --worker) worker=$2 ;; -C) dir=$2 ;; --model) model=$2; model_given=1 ;;
        --effort) effort=$2; effort_given=1 ;; --provider) provider=$2; provider_given=1 ;;
        --via) via=$2 ;; --evidence) evidence=$2 ;; --timeout) timeout=$2 ;; --access) access=$2 ;;
        --resume) resume=$2; keep=1; [[ $resume =~ '^[A-Za-z0-9][A-Za-z0-9-]*$' ]] || die 'invalid --resume session ID' 2 ;;
        --lease) [[ -n $2 ]] || die '--lease requires a nonempty file path' 2; lease=$2 ;;
        --lease-wait) lease_wait=$2 ;;
      esac
      shift ;;
    --edit) access=edit ;; --pro) pro=1 ;; --keep) keep=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -?*) usage >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
(( $# == 1 )) || { usage >&2; exit 2; }
brief=$1
[[ $brief == - ]] && brief=$(cat)
[[ -n ${brief//[[:space:]]/} ]] || die 'empty brief' 2
[[ -n $dir && -d $dir ]] || die 'an existing -C DIR is required' 2
[[ $timeout == <1-86400> ]] || die '--timeout must be 1-86400 seconds' 2
[[ $lease_wait == <1-86400> ]] || die '--lease-wait must be 1-86400 seconds' 2
(( ! model_given )) || valid_model "$model" || die 'invalid model name' 2
marker=${AGENT_WORKER_ROUTER_LEASE_VAR:-AGENT_WORKER_ROUTER_LEASE_HELD}
[[ $marker =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || die 'invalid AGENT_WORKER_ROUTER_LEASE_VAR' 2
[[ -z ${(P)marker:-} ]] || die "nested launch refused: $marker is inherited from an outer leased worker" 77
[[ $access == read || $access == edit || $access == full ]] || die '--access must be read, edit, or full' 2
if [[ $access == full ]]; then
  [[ -z $evidence ]] || die '--evidence is incompatible with full access' 2
  print -u2 -- 'agent-worker-router: FULL ACCESS: -C does not restrict reading or writing; the worker can access Keychain and other user files'
fi
dir=${dir:A}
home_real=${HOME:A}
if [[ $access != full ]]; then
  [[ $dir != / && $dir != $home_real ]] || die '-C directory is too broad' 2
  # Code planted under the last three runs later outside any sandbox: Codex config, rules and hooks,
  # ~/.local/bin, launch agents.
  for private in "$HOME/.ssh" "$HOME/.aws" "$HOME/.gnupg" "$HOME/.config" "$HOME/.claude" "$HOME/Library/Keychains" \
                 "${CODEX_HOME:-$HOME/.codex}" "$HOME/.local" "$HOME/Library/LaunchAgents"; do
    private=${private:A}
    [[ $dir != $private && $dir != $private/* && $private != $dir/* ]] || die '-C directory includes private configuration' 2
  done
fi

case $worker in
  deepseek)
    (( ! model_given )) || die 'use --pro for DeepSeek; --model is not supported' 2
    (( ! effort_given && ! provider_given && ! keep )) || die '--effort, --provider, --keep and --resume are not supported for DeepSeek' 2 ;;
  claude|codex)
    (( ! pro )) || die '--pro is only for DeepSeek' 2
    [[ -z $evidence ]] || die '--evidence currently supports DeepSeek only' 2
    whence -p jq > /dev/null || die 'jq not found' ;;
  *) die 'unknown worker: expected deepseek, claude, or codex' 2 ;;
esac
if [[ $worker == claude ]]; then
  efforts='low medium high xhigh max'
  (( ! provider_given )) || die '--provider is only for Codex' 2
elif [[ $worker == codex ]]; then
  efforts='none minimal low medium high xhigh'
  (( ! provider_given )) || valid_provider "$provider" || die 'invalid provider ID' 2
fi
(( ! effort_given )) || valid_effort "$effort" || die "--effort for $worker must be one of: $efforts" 2
[[ -z $via || $worker == codex ]] || die '--via is only for Codex' 2
[[ -z $via || $via == plugin || $via == cli ]] || die '--via must be plugin or cli' 2

if [[ $worker == claude ]]; then
  claude_limit_file="$HOME/.config/agent-worker-router/claude-limit-until"
  if [[ -f $claude_limit_file && ! -L $claude_limit_file ]]; then
    claude_limit_until=$(< "$claude_limit_file")
    if [[ $claude_limit_until == <-> ]] && (( claude_limit_until > $(date +%s) )); then
      die "Claude usage limit until $(limit_time "$claude_limit_until"); skipping call" 75
    fi
  fi
fi

if [[ $access == full ]]; then
  if [[ $worker == deepseek ]]; then
    if [[ -n $lease ]]; then
      # DeepSeek owns its dialog; ask cannot run inside a held lease.
      full_policy="$HOME/.config/agent-worker-router/full-access-policy"
      [[ -f $full_policy && ! -L $full_policy && $(< "$full_policy") == allow ]] || die 'DeepSeek full access with a lease requires the existing full-access allow policy; ask would hold the lease during its dialog' 2
    fi
  else
    "${0:A:h}/authorize-full" "$worker" "$dir" || die 'full access was not authorized' 2
  fi
fi

[[ -z $lease ]] || lease=${lease:a}
launch_file=$(mktemp "${TMPDIR:-/tmp}/agent-worker-started.XXXXXX")
# Worker exits 76/78 must not be mistaken for supervisor refusals before launch.
trap 'rm -f -- "$launch_file"' EXIT
if [[ $worker == deepseek ]]; then
  args=(-C "$dir" --timeout "$timeout")
  [[ $access != edit ]] || args=(--edit "${args[@]}")
  [[ $access != full ]] || args=(--full "${args[@]}")
  (( pro )) && args=(--pro "${args[@]}")
  [[ -z $evidence ]] || args=(--evidence "$evidence" "${args[@]}")
  command=("${0:A:h}/deepseek" "${args[@]}" "$brief")
  [[ -z $lease ]] || command=(env "$marker=$$" "AGENT_WORKER_ROUTER_LEASE_VAR=$marker" "${command[@]}")
  rc=0
  run_worker 0 "${command[@]}" || rc=$?
  [[ -s $launch_file || $rc != 78 ]] || die 'worker supervisor failed' 1
  exit $rc
fi

if [[ $worker == codex ]]; then
  config=${CODEX_HOME:-$HOME/.codex}/config.toml
  if [[ -f $config ]]; then
    # This reader accepts only single-line quoted scalars before the first table, never profiles.
    defaults=$(perl -ne 'last if /^\s*\[/; print "$1=$2\n" if /^\s*(model|model_reasoning_effort|model_provider)\s*=\s*"([^"\\]*)"\s*(?:#.*)?$/' "$config") || { warn 'could not read Codex defaults'; defaults=; }
    while IFS= read -r line; do
      key=${line%%=*} value=${line#*=}
      case $key in
        model) (( model_given )) && continue; valid_model "$value" && model=$value || warn 'ignoring invalid Codex default model' ;;
        model_reasoning_effort) (( effort_given )) && continue; valid_effort "$value" && effort=$value || warn 'ignoring invalid Codex default effort' ;;
        model_provider) (( provider_given )) && continue; valid_provider "$value" && provider=$value || warn 'ignoring invalid Codex default provider' ;;
      esac
    done <<< "$defaults"
  fi
  provider_table=
  if [[ -n $provider && -f $config ]]; then
    provider_table=$(perl -e '
      my ($id, $file) = @ARGV;
      open my $f, "<", $file or die "cannot read provider table\n";
      my (%keys, $inside, $found);
      while (<$f>) {
        if (/^\s*\[/) { $inside = /^\s*\[model_providers\.\Q$id\E\]\s*(?:#.*)?$/; $found ||= $inside; next }
        next unless $inside;
        $keys{$1} = qq{"$2"} if /^\s*(name|base_url|wire_api)\s*=\s*"([^"\\]*)"\s*(?:#.*)?$/;
        $keys{$1} = $2 if /^\s*(requires_openai_auth)\s*=\s*(true|false)\s*(?:#.*)?$/;
      }
      print "{", join(",", map { "$_=$keys{$_}" } grep { exists $keys{$_} } qw(name base_url wire_api requires_openai_auth)), "}" if $found;
    ' "$provider" "$config") || warn 'could not read Codex provider table'
  fi
  # The Claude Code plugin openai/codex-plugin-cc is preferred whenever it can honor this call exactly.
  companion= why=
  if [[ $via != cli ]]; then
    claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
    plugin_root=$(jq -r '.plugins["codex@openai-codex"][0].installPath // empty' "$claude_home/plugins/installed_plugins.json" 2>/dev/null) || plugin_root=
    if [[ -z $plugin_root || ! -f $plugin_root/scripts/codex-companion.mjs ]]; then why='it is not installed'
    elif [[ $(jq -r '.enabledPlugins["codex@openai-codex"] // false' "$claude_home/settings.json" 2>/dev/null) != true ]]; then why='it is not enabled'
    else
      if ! node_bin=$(whence -p node); then why='node is not found'
      elif [[ -n $resume ]]; then why='it resumes only its own latest thread, not --resume ID'
      elif [[ $access == full ]]; then why='it has no full access'
      # The runtime starts Codex in the Git root of --cwd, which would widen a subdirectory -C.
      elif git_root=$(env -i "HOME=$HOME" "PATH=$PATH" git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [[ ${git_root:A} != $dir ]]; then why="it would start in the repository root $git_root"
      # The app-server has no --ignore-user-config or --ignore-rules. In a trusted -C a project layer can add
      # MCP servers and rules, and an execpolicy allow rule runs its command outside the sandbox (seen 2026-11-03).
      elif [[ -e $dir/.codex ]]; then why="it would load the project configuration in $dir/.codex"
      elif [[ -n $(print -l -- "${CODEX_HOME:-$HOME/.codex}"/rules/*(N)) ]]; then why='it would apply execpolicy rules, which run matching commands outside the sandbox'
      else companion=$plugin_root/scripts/codex-companion.mjs
      fi
      [[ -z $why || $via == plugin ]] || warn "Codex plugin skipped because $why; using the CLI"
    fi
    [[ -z $why || $via != plugin ]] || die "Codex plugin cannot run this call: $why" 1
  fi
else
  config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
  if [[ -e $config ]]; then
    if defaults=$(jq -sce 'select(length == 1 and (.[0] | type == "object")) | .[0] | {model,effortLevel}' "$config" 2>/dev/null); then
      for key in model effortLevel; do
        [[ $key != model || $model_given == 0 ]] || continue
        [[ $key != effortLevel || $effort_given == 0 ]] || continue
        print -r -- "$defaults" | jq -e --arg k "$key" '.[$k] != null' >/dev/null || continue
        value=$(print -r -- "$defaults" | jq -r --arg k "$key" '.[$k] | if type == "string" then . else "\u0001" end')
        if [[ $key == model ]]; then
          valid_model "$value" && model=$value || warn 'ignoring invalid Claude default model'
        else
          valid_effort "$value" && effort=$value || warn 'ignoring invalid Claude default effort'
        fi
      done
    else
      warn 'could not read valid Claude defaults'
    fi
  fi
fi

worker_env=("HOME=$HOME" "PATH=$PATH" "USER=${USER:-}" "LOGNAME=${LOGNAME:-}"
            SHELL=/bin/zsh "TMPDIR=${TMPDIR:-/tmp}" "LANG=${LANG:-en_US.UTF-8}" TERM=dumb)
for key in HTTPS_PROXY HTTP_PROXY ALL_PROXY NO_PROXY https_proxy http_proxy all_proxy no_proxy CODEX_HOME CLAUDE_CONFIG_DIR; do
  (( ${+parameters[$key]} )) || continue
  value=${(P)key}
  if [[ $key != CODEX_HOME && $key != CLAUDE_CONFIG_DIR && $value == *@* ]]; then
    warn "dropping $key because its proxy value contains credentials"
  else
    worker_env+=("$key=$value")
  fi
done
[[ -z $lease ]] || worker_env+=("$marker=$$" "AGENT_WORKER_ROUTER_LEASE_VAR=$marker")

out=$(mktemp "${TMPDIR:-/tmp}/agent-worker-router.XXXXXX")
emit_receipt() {
  local final_rc=$1 effective_model=unverified effective_effort=unverified effective_provider=unverified effective_access=unverified session=unverified tokens='"unverified"' key value
  local log=$out kept=$keep sandbox= reporter='the CLI'
  local -a rollout
  (( ran )) || return 0
  if [[ $route == plugin ]]; then
    # The runtime always persists its thread; its rollout records what Codex actually ran with.
    kept=1 reporter='the rollout'
    [[ -z $thread ]] || { session=$thread; rollout=("${CODEX_HOME:-$HOME/.codex}"/sessions/*/*/*/rollout-*-"$thread".jsonl(N)); }
    if (( $#rollout == 1 )); then
      log=$rollout[1]
      while IFS=$'\t' read -r key value; do
        case $key in
          model) effective_model=$value ;; effort) effective_effort=$value ;; provider) effective_provider=$value ;;
          sandbox) sandbox=$value ;; tokens) tokens=$(jq -nc --argjson total "$value" '{total:$total}') ;;
        esac
      # Lines are parsed one by one: a timeout can leave the last line half-written.
      done < <(jq -Rrn '
        reduce (inputs | try fromjson catch null | objects) as $l ({};
          if $l.type == "session_meta" then .provider = $l.payload.model_provider
          elif $l.type == "turn_context" then .model = $l.payload.model | .effort = $l.payload.effort | .sandbox = $l.payload.sandbox_policy.type
          elif $l.type == "event_msg" and $l.payload.type == "token_count" then .tokens = ($l.payload.info.total_token_usage.total_tokens? // .tokens)
          else . end)
        | to_entries[] | select(.value | type == "string" or type == "number") | "\(.key)\t\(.value)"' "$log")
    fi
  elif [[ $worker == codex ]]; then
    while IFS=$'\t' read -r key value; do
      case $key in
        model) effective_model=$value ;; effort) effective_effort=$value ;;
        provider) effective_provider=$value ;; session) session=$value ;; sandbox) sandbox=$value ;;
      esac
    done < <(perl -ne '
      last if $. > 20;
      if (/^OpenAI Codex v/) { $seen = 1; next }
      next unless $seen;
      if (/^--------\s*$/) { last if $inside; $inside = 1; next }
      next unless $inside;
      print "$1\t$2\n" if /^(model|provider): (.+)$/;
      print "sandbox\t$1\n" if /^sandbox: (\S+)/;
      print "effort\t$1\n" if /^reasoning effort: (.+)$/;
      print "session\t$1\n" if /^session id: (.+)$/;
    ' "$out")
    value=$(perl -ne '
      if (/^tokens used\s*:?\s*([0-9][0-9,]*)?\s*$/) { $next = 1; $n = $1 if defined $1; next }
      if ($next && /^\s*([0-9][0-9,]*)\s*$/) { $n = $1 }
      $next = 0;
      END { if (defined $n) { $n =~ s/,//g; print $n } }
    ' "$out")
    [[ -z $value ]] || tokens=$(jq -nc --argjson total "$value" '{total:$total}')
  elif jq -se 'length == 1 and (.[0] | type == "object")' "$out" >/dev/null 2>&1; then
    effective_model=$(jq -r '(.modelUsage // {}) | if type == "object" and length > 0 then keys | join(",") else "unverified" end' "$out")
    effective_effort=$(jq -r '.effort // "unverified"' "$out")
    session=$(jq -r '.session_id // "unverified"' "$out")
    tokens=$(jq -c 'try (if (.usage.input_tokens | type) == "number" and (.usage.output_tokens | type) == "number" then {input:.usage.input_tokens,output:.usage.output_tokens} else "unverified" end) catch "unverified"' "$out")
  fi
  case $sandbox in
    read-only) effective_access=read ;; workspace-write) effective_access=edit ;;
    danger-full-access) effective_access=full ;; ?*) effective_access=$sandbox ;;
  esac
  if [[ $worker == codex ]]; then
    for key in model effort provider access; do
      value=effective_$key
      if [[ -n ${(P)key} && ${(P)value} != unverified && ${(P)key} != ${(P)value} ]]; then
        warn "requested $key ${(P)key} but $reporter reports ${(P)value}"
      fi
    done
  fi
  print -ru2 -- "agent-worker-router: receipt $(jq -nc \
    --arg worker "$worker" --arg route "$route" --arg model "$effective_model" --arg effort "$effective_effort" \
    --arg provider "$effective_provider" --arg access "$effective_access" --arg session "$session" --argjson exit "$final_rc" \
    --argjson duration "$SECONDS" --argjson tokens "$tokens" --argjson kept "$kept" \
    --arg requested_model "$model" --arg requested_effort "$effort" --arg requested_provider "$provider" --arg requested_access "$access" --arg log "$log" \
    '{worker:$worker,path:$route,model:$model,effort:$effort,provider:$provider,access:$access,session:$session,exit:$exit,duration_s:$duration,tokens:$tokens,kept:($kept == 1),requested:{model:($requested_model | if . == "" then null else . end),effort:($requested_effort | if . == "" then null else . end),provider:($requested_provider | if . == "" then null else . end),access:$requested_access},log:$log}')"
}
run_tmp= confine=()
trap 'final_rc=$?; emit_receipt $final_rc; rm -f -- "$launch_file"; [[ -z $run_tmp ]] || rm -rf -- "$run_tmp"' EXIT
if [[ $worker == codex && $access != full ]]; then
  # The private tmp/ is the only writable root besides -C: the caller's TMPDIR and /tmp are shared with every
  # other process of the user. The empty zdotdir/ keeps the user's zsh dotfiles out of worker shells.
  run_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-worker-codex.XXXXXX")
  mkdir "$run_tmp/tmp" "$run_tmp/zdotdir"
  worker_env+=("ZDOTDIR=$run_tmp/zdotdir")
  names=(${worker_env%%=*})
  # Both routes. Measured 2026-11-03 on codex 0.163.0 with a scripted model: without these a worker ran
  # execpolicy-allowed commands outside the sandbox, wrote to /tmp and to the caller's TMPDIR, and got dotfile
  # exports and `shell_environment_policy.set`; on the plugin route it also wrote to user `writable_roots` and
  # got MCP servers. A worker never starts workers, so sub-agents are off as well.
  confine=(-c features.plugins=false -c features.hooks=false -c features.apps=false -c features.multi_agent=false
           -c 'notify=[]' -c 'web_search="disabled"' -c allow_login_shell=false
           -c 'sandbox_workspace_write.writable_roots=[]' -c sandbox_workspace_write.exclude_slash_tmp=true
           -c "shell_environment_policy.include_only=[${(j:,:)${(@qqq)names}}]")
  [[ $access != edit ]] || confine+=(-c sandbox_workspace_write.network_access=false)
  # Production CLIs listed by the policy file and its local addition (destructive-rules.local.json next to it) meet
  # a refusing stub first on the PATH of worker shells (not of Codex itself). The sandbox already cuts their
  # network; the stub refuses before they even start.
  policy=${AGENT_WORKER_ROUTER_POLICY:-$HOME/.config/agent-worker-router/destructive-rules.json}
  policies=()
  for file in $policy ${policy:h}/destructive-rules.local.json; do
    [[ -f $file ]] && policies+=($file)
  done
  if (( $#policies )); then
    denied=$(jq -rs '[.[].worker_deny_commands[]? | strings | select(test("^[A-Za-z0-9._-]+$"))] | unique | .[]' $policies) || { warn "could not read worker_deny_commands from ${(j:, :)policies}"; denied=; }
    if [[ -n $denied ]]; then
      mkdir "$run_tmp/deny"
      for name in ${(f)denied}; do
        print -rl -- '#!/bin/sh' "echo 'agent-worker-router: $name is not available to workers: production systems need the user' >&2" 'exit 126' > "$run_tmp/deny/$name"
      done
      chmod 700 "$run_tmp"/deny/*
      confine+=(-c "shell_environment_policy.set.PATH=$(jq -nc --arg p "$run_tmp/deny:$PATH" '$p')")
    fi
  fi
fi
cd "$dir"
rc=0
if [[ $worker == claude ]]; then
  claude_bin=$(whence -p claude) || die 'Claude Code CLI not found'
  # Agent hosts pass a socket as stdin and script(1) fails on it; it only needs a pty for the child.
  cli_help=$(env -i "${worker_env[@]}" /usr/bin/script -q /dev/null "$claude_bin" --help < /dev/null) || die 'could not inspect Claude Code CLI'
  for flag in --restricted --strict-mcp-config --safe-mode --no-session-persistence --disable-slash-commands --tools --permission-mode; do
    [[ $cli_help == *$flag* ]] || die "Claude Code CLI does not support $flag"
  done
  for flag in ${effort:+--effort} ${resume:+--resume}; do
    [[ $cli_help == *$flag* ]] || die "Claude Code CLI does not support $flag"
  done
  [[ $access != full || $cli_help == *--dangerously-skip-permissions* ]] || die 'Claude Code CLI does not support full access'
  tools=(Read Grep Glob)
  mode=dontAsk
  [[ $access != edit ]] || { tools+=(Edit Write); mode=acceptEdits; }
  args=(-p --safe-mode --strict-mcp-config)
  (( keep )) || args+=(--no-session-persistence)
  args+=(
        --disable-slash-commands --output-format json
        --permission-prompts none
        --disallowedTools 'Read(**/.env*)' 'Read(**/*.pem)' 'Read(**/*.key)' 'Read(**/*.p12)'
                          'Read(**/id_rsa*)' 'Read(**/id_ed25519*)' 'Read(**/.netrc)'
                          'Grep(**/.env*)' 'Grep(**/*.pem)' 'Grep(**/*.key)' 'Grep(**/*.p12)'
                          'Grep(**/id_rsa*)' 'Grep(**/id_ed25519*)' 'Grep(**/.netrc)'
                          'Edit(**/.env*)' 'Edit(**/*.pem)' 'Edit(**/*.key)' 'Edit(**/*.p12)'
                          'Edit(**/id_rsa*)' 'Edit(**/id_ed25519*)' 'Edit(**/.netrc)'
                          'Write(**/.env*)' 'Write(**/*.pem)' 'Write(**/*.key)' 'Write(**/*.p12)'
                          'Write(**/id_rsa*)' 'Write(**/id_ed25519*)' 'Write(**/.netrc)')
  if [[ $access == full ]]; then
    args+=(--dangerously-skip-permissions --tools default)
  else
    args+=(--restricted --permission-mode "$mode" --tools "${(j:,:)tools}")
  fi
  [[ -z $model ]] || args+=(--model "$model")
  [[ -z $effort ]] || args+=(--effort "$effort")
  [[ -z $resume ]] || args+=(--resume "$resume")
  print -rn -- "$brief" | run_worker "$timeout" env -i "${worker_env[@]}" \
      CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
      "$claude_bin" "${args[@]}" > "$out" || rc=$?
  if [[ ! -s $launch_file ]]; then
    (( rc != 76 )) || die "lease wait timed out: $lease" 76
    die 'worker supervisor failed' 1
  fi
  ran=1
  (( rc != 142 )) || die "timed out after ${timeout}s; partial JSON: $out" 124
  jq -e 'type == "object" and (.result | type == "string") and ((.modelUsage // {}) | type == "object")' "$out" >/dev/null || die "invalid Claude JSON (exit $rc): $out"
  foreign=$(jq -r '.modelUsage // {} | keys[] | select(startswith("claude-") | not)' "$out")
  [[ -z $foreign ]] || die "a non-Claude model responded: $foreign" 3
  if (( rc != 0 )) || [[ $(jq -r '.is_error' "$out") != false ]]; then
    failure=$(jq -r '.result // empty' "$out")
    print -u2 -- "$failure"
    if [[ $failure == *'session limit'* && $failure =~ 'resets ([0-9]{1,2})(:([0-9]{2}))?(am|pm) \(([-A-Za-z_+/]+)\)' ]]; then
      reset_hour=$match[1] reset_minute=${match[3]:-00} reset_period=$match[4] reset_zone=$match[5]
      if [[ -f /usr/share/zoneinfo/$reset_zone ]]; then
        reset_day=$(TZ="$reset_zone" date +%Y-%m-%d)
        reset_until=$(TZ="$reset_zone" date -j -f '%Y-%m-%d %I:%M:%S%p' "$reset_day $reset_hour:$reset_minute:00$reset_period" +%s) || reset_until=
        if [[ -n $reset_until ]]; then
          if (( reset_until <= $(date +%s) )); then
            reset_day=$(TZ="$reset_zone" date -v+1d +%Y-%m-%d)
            reset_until=$(TZ="$reset_zone" date -j -f '%Y-%m-%d %I:%M:%S%p' "$reset_day $reset_hour:$reset_minute:00$reset_period" +%s) || reset_until=
          fi
          if [[ -n $reset_until ]]; then
            mkdir -p "${claude_limit_file:h}"
            chmod 700 "${claude_limit_file:h}"
            limit_tmp=$(mktemp "${claude_limit_file:h}/claude-limit.XXXXXX")
            print -r -- "$reset_until" > "$limit_tmp"
            mv -- "$limit_tmp" "$claude_limit_file"
            print -u2 -- "agent-worker-router: Claude usage limit until $(limit_time "$reset_until"); future calls will be skipped"
          fi
        fi
      fi
    fi
    die "Claude failed (exit $rc): $out"
  fi
  jq -e '(.modelUsage // {} | length) > 0 and (.result | length > 0)' "$out" >/dev/null || die "empty Claude response: $out"
  jq -r '.result' "$out"
else
  codex_bin=$(whence -p codex) || die 'Codex CLI not found'
  if [[ -n $companion ]]; then
    plugin_help=$(env -i "${worker_env[@]}" "$node_bin" "$companion" help) || plugin_help=
    if [[ $plugin_help != *'task '*--write*--model*--effort* ]]; then
      [[ $via != plugin ]] || die 'Codex plugin runtime does not support task --write --model --effort'
      warn 'Codex plugin runtime does not support task --write --model --effort; using the CLI'
      companion=
    fi
  fi
  if [[ -n $companion ]]; then
    sandbox=read-only
    [[ $access != edit ]] || sandbox=workspace-write
    # The runtime starts `codex app-server` with the whole user config; `confine` switches off what the CLI
    # route never loads. On 2026-11-03 `codex mcp list` went from 24 servers in 5.3 s to 21 disabled in 0.02 s.
    overrides=("${confine[@]}" -c "sandbox_mode=\"$sandbox\"")
    [[ -z $provider ]] || overrides+=(-c "model_provider=\"$provider\"")
    if [[ -f $config ]]; then
      # Server tables, dotted keys and inline values that start a line; Codex's listing below catches the rest.
      for name in ${(fu)"$(perl -ne 'print "$1$2\n" if /^\s*\[?\s*mcp_servers\.(?:"([A-Za-z0-9_-]+)"|([A-Za-z0-9_-]+))[\s.\]=]/' "$config")"}; do
        overrides+=(-c "mcp_servers.$name.enabled=false")
      done
    fi
    enabled=$(env -i "${worker_env[@]}" "$codex_bin" mcp list --json "${overrides[@]}" < /dev/null 2>/dev/null |
              jq -er '[.[] | select(.enabled) | .name] | join(" ")') || enabled='unknown (codex mcp list failed)'
    if [[ -n $enabled ]]; then
      [[ $via != plugin ]] || die "Codex plugin cannot run this call: MCP servers would start: $enabled"
      warn "Codex plugin skipped because MCP servers would start: $enabled; using the CLI"
      companion=
    fi
  fi
  if [[ -n $companion ]]; then
    mkdir "$run_tmp/bin"
    print -rl -- '#!/bin/zsh' \
      "[[ \$* != app-server ]] || : > ${(q)run_tmp}/isolated" \
      "[[ \$1 != app-server ]] || TMPDIR=${(q)run_tmp}/tmp exec ${(q)codex_bin} app-server ${(j: :)${(@q)overrides}} \"\${@:2}\"" \
      "exec ${(q)codex_bin} \"\$@\"" > "$run_tmp/bin/codex"
    chmod 700 "$run_tmp/bin/codex"
    args=(task --json --cwd "$dir")
    [[ $access != edit ]] || args+=(--write)
    [[ -z $model ]] || args+=(--model "$model")
    [[ -z $effort ]] || args+=(--effort "$effort")
    # A missing broker socket makes the runtime start its own app-server instead of a detached shared broker,
    # which would outlive both the lease and the timeout. The runtime retries direct only on ENOENT: a socket
    # path over 104 bytes gives EINVAL, a missing directory under / always ENOENT. Its job state stays in
    # run_tmp, out of reach of the worker, whose writable TMPDIR the shim sets to run_tmp/tmp.
    print -rn -- "$brief" | run_worker "$timeout" env -i "${worker_env[@]}" "PATH=$run_tmp/bin:$PATH" "TMPDIR=$run_tmp" \
        CODEX_COMPANION_APP_SERVER_ENDPOINT=unix:/nonexistent/agent-worker-no-broker.sock "$node_bin" "$companion" "${args[@]}" > "$out" || rc=$?
    if [[ ! -s $launch_file ]]; then
      (( rc != 76 )) || die "lease wait timed out: $lease" 76
      die 'worker supervisor failed' 1
    fi
    # The job record names the thread as soon as it exists, even when the runtime fails later.
    thread=$(jq -r '.threadId // empty' "$out" 2>/dev/null) || thread=
    [[ -n $thread ]] || thread=$(cat -- "$run_tmp"/codex-companion/*/jobs/*.json(N) /dev/null | jq -r '.threadId // empty' 2>/dev/null) || thread=
    [[ $thread =~ '^[A-Za-z0-9-]+$' ]] || thread=
    # Falling back after a thread exists could repeat its edits, so only a failure before any thread retries on the CLI.
    if (( rc == 0 || rc == 142 )) || [[ -n $thread || $via == plugin ]]; then
      route=plugin ran=1
      # A runtime that stops resolving `codex` through PATH would bypass the shim and load the full user config.
      [[ -z $thread || -e $run_tmp/isolated ]] || warn 'Codex plugin started app-server without the isolation shim: MCP servers, plugins and hooks of the user config may have run'
      (( rc != 142 )) || die "timed out after ${timeout}s; partial output: $out" 124
      (( rc == 0 )) && jq -er '.rawOutput | strings | select(length > 0)' "$out" 2>/dev/null || die "Codex exited without a response (exit $rc): $out" 1
      exit 0
    fi
    warn "Codex plugin failed before starting a thread (exit $rc); using the CLI"
    : > "$launch_file"
    rc=0
  fi
  cli_help=$(env -i "${worker_env[@]}" "$codex_bin" exec --help) || die 'could not inspect Codex CLI'
  for flag in --sandbox --ephemeral --ignore-user-config --ignore-rules --output-last-message; do
    [[ $cli_help == *$flag* ]] || die "Codex CLI does not support $flag"
  done
  if [[ -n $resume ]]; then
    cli_help=$(env -i "${worker_env[@]}" "$codex_bin" exec resume --help) || die 'could not inspect Codex resume CLI'
    for flag in --ignore-user-config --ignore-rules --output-last-message -c; do
      [[ $cli_help == *$flag* ]] || die "Codex resume CLI does not support $flag"
    done
  fi
  [[ $access != full || $cli_help == *--dangerously-bypass-approvals-and-sandbox* ]] || die 'Codex CLI does not support full access'
  answer=$(mktemp "${TMPDIR:-/tmp}/agent-worker-answer.XXXXXX")
  args=(exec)
  if [[ -n $resume ]]; then
    args+=(resume)
  elif (( ! keep )); then
    args+=(--ephemeral)
  fi
  # --ignore-user-config keeps $CODEX_HOME/rules: an allow rule there runs its command outside the sandbox.
  args+=(--ignore-user-config --ignore-rules --skip-git-repo-check --output-last-message "$answer")
  [[ -n $resume ]] || args+=(-C "$dir")
  case $access in
    read|edit)
      sandbox=read-only
      [[ $access != edit ]] || sandbox=workspace-write
      if [[ -n $resume ]]; then
        args+=(-c "sandbox_mode=\"$sandbox\"")
      else
        args+=(--sandbox "$sandbox")
      fi
      args+=("${confine[@]}") ;;
    full) args+=(--dangerously-bypass-approvals-and-sandbox) ;;
  esac
  [[ -z $model ]] || args+=(-m "$model")
  [[ -z $effort ]] || args+=(-c "model_reasoning_effort=\"$effort\"")
  if [[ -n $provider ]]; then
    args+=(-c "model_provider=\"$provider\"")
    [[ -z $provider_table ]] || args+=(-c "model_providers.$provider=$provider_table")
  fi
  [[ -z $resume ]] || args+=("$resume")
  print -rn -- "$brief" | run_worker "$timeout" env -i "${worker_env[@]}" ${run_tmp:+"TMPDIR=$run_tmp/tmp"} \
      "$codex_bin" "${args[@]}" - > "$out" 2>&1 || rc=$?
  if [[ ! -s $launch_file ]]; then
    (( rc != 76 )) || die "lease wait timed out: $lease" 76
    cat -- "$out" >&2
    die 'worker supervisor failed' 1
  fi
  ran=1
  (( rc != 142 )) || die "timed out after ${timeout}s; partial transcript: $out" 124
  (( rc == 0 )) && [[ -s $answer ]] || die "Codex exited without a response (exit $rc): $out" 1
  cat -- "$answer"
fi
