#!/bin/zsh
# Fresh external workers. This is not a native host subagent or a security sandbox.
set -euo pipefail
umask 077

usage() { print 'usage: agent-worker-router --worker deepseek|claude|codex -C DIR [--access read|edit|full] [--model MODEL] [--effort LEVEL] [--provider ID] [--pro] [--evidence FILE] [--timeout SEC] [--keep] [--resume SESSION_ID] [--lease FILE] [--lease-wait SEC] BRIEF|-'; }
die() { print -u2 -- "agent-worker-router: $1"; exit ${2:-1}; }
limit_time() { print -- "$(date -r "$1" '+%Y-%m-%d %H:%M %Z') (~$(( ($1 - $(date +%s) + 59) / 60 ))m)"; }

valid_model() { [[ $1 =~ '^[A-Za-z0-9]([A-Za-z0-9_.:-]|\[|\])*$' ]]; }
valid_provider() { [[ $1 =~ '^[A-Za-z0-9_-]+$' ]]; }
valid_effort() { [[ -n $1 && $1 != *[[:space:]]* && " $efforts " == *" $1 "* ]]; }
warn() { print -ru2 -- "agent-worker-router: warning: $1"; }
run_worker() {
  perl -e '
    use strict;
    use warnings;
    my ($file, $wait, $timeout, $started) = splice @ARGV, 0, 4;
    my $lease;
    if (length $file) {
      open $lease, ">>", $file or do { warn "lease $file: $!\n"; exit 78 };
      $SIG{ALRM} = sub { warn "lease wait timed out: $file\n"; exit 76 };
      alarm $wait;
      flock $lease, 2 or do { warn "lease $file: $!\n"; exit 78 };
      alarm 0;
    }
    open my $receipt, ">", $started or do { warn "launch marker: $!\n"; exit 78 };
    my $pid = fork;
    defined $pid or do { warn "fork: $!\n"; exit 78 };
    if (!$pid) {
      $SIG{ALRM} = "DEFAULT";
      alarm $timeout;
      # Perl closes the lease fd on exec so worker daemons cannot retain it.
      exec @ARGV or die "exec: $!\n";
    }
    print $receipt "1\n";
    close $receipt;
    waitpid $pid, 0;
    exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
  ' "$lease" "$lease_wait" "$1" "$launch_file" "${@:2}"
}

worker= dir= model= effort= provider= evidence= timeout=300 access=read pro=0 keep=0 resume=
model_given=0 effort_given=0 provider_given=0 ran=0
lease=${AGENT_WORKER_ROUTER_LEASE:-} lease_wait=${AGENT_WORKER_ROUTER_LEASE_WAIT:-900}
while (( $# )); do
  case $1 in
    --worker|-C|--model|--effort|--provider|--evidence|--timeout|--access|--resume|--lease|--lease-wait)
      (( $# >= 2 )) || die "$1 requires an argument" 2
      case $1 in
        --worker) worker=$2 ;; -C) dir=$2 ;; --model) model=$2; model_given=1 ;;
        --effort) effort=$2; effort_given=1 ;; --provider) provider=$2; provider_given=1 ;;
        --evidence) evidence=$2 ;; --timeout) timeout=$2 ;; --access) access=$2 ;;
        --resume) resume=$2; keep=1; [[ $resume =~ '^[A-Za-z0-9][A-Za-z0-9-]*$' ]] || die 'invalid --resume session ID' 2 ;;
        --lease) [[ -n $2 ]] || die '--lease requires a nonempty file path' 2; lease=$2 ;;
        --lease-wait) lease_wait=$2 ;;
      esac
      shift ;;
    --edit) access=edit ;; --pro) pro=1 ;; --keep) keep=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -?*) usage >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
(( $# == 1 )) || { usage >&2; exit 2; }
brief=$1
[[ $brief == - ]] && brief=$(cat)
[[ -n ${brief//[[:space:]]/} ]] || die 'empty brief' 2
[[ -n $dir && -d $dir ]] || die 'an existing -C DIR is required' 2
[[ $timeout == <1-86400> ]] || die '--timeout must be 1-86400 seconds' 2
[[ $lease_wait == <1-86400> ]] || die '--lease-wait must be 1-86400 seconds' 2
(( ! model_given )) || valid_model "$model" || die 'invalid model name' 2
marker=${AGENT_WORKER_ROUTER_LEASE_VAR:-AGENT_WORKER_ROUTER_LEASE_HELD}
[[ $marker =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || die 'invalid AGENT_WORKER_ROUTER_LEASE_VAR' 2
[[ -z ${(P)marker:-} ]] || die "nested launch refused: $marker is inherited from an outer leased worker" 77
[[ $access == read || $access == edit || $access == full ]] || die '--access must be read, edit, or full' 2
if [[ $access == full ]]; then
  [[ -z $evidence ]] || die '--evidence is incompatible with full access' 2
  print -u2 -- 'agent-worker-router: FULL ACCESS: -C does not restrict reading or writing; the worker can access Keychain and other user files'
fi
dir=${dir:A}
home_real=${HOME:A}
if [[ $access != full ]]; then
  [[ $dir != / && $dir != $home_real ]] || die '-C directory is too broad' 2
  for private in "$HOME/.ssh" "$HOME/.aws" "$HOME/.gnupg" "$HOME/.config" "$HOME/.claude" "$HOME/Library/Keychains"; do
    private=${private:A}
    [[ $dir != $private && $dir != $private/* && $private != $dir/* ]] || die '-C directory includes private configuration' 2
  done
fi

case $worker in
  deepseek)
    (( ! model_given )) || die 'use --pro for DeepSeek; --model is not supported' 2
    (( ! effort_given && ! provider_given && ! keep )) || die '--effort, --provider, --keep and --resume are not supported for DeepSeek' 2 ;;
  claude|codex)
    (( ! pro )) || die '--pro is only for DeepSeek' 2
    [[ -z $evidence ]] || die '--evidence currently supports DeepSeek only' 2
    whence -p jq > /dev/null || die 'jq not found' ;;
  *) die 'unknown worker: expected deepseek, claude, or codex' 2 ;;
esac
if [[ $worker == claude ]]; then
  efforts='low medium high xhigh max'
  (( ! provider_given )) || die '--provider is only for Codex' 2
elif [[ $worker == codex ]]; then
  efforts='none minimal low medium high xhigh'
  (( ! provider_given )) || valid_provider "$provider" || die 'invalid provider ID' 2
fi
(( ! effort_given )) || valid_effort "$effort" || die "--effort for $worker must be one of: $efforts" 2

if [[ $worker == claude ]]; then
  claude_limit_file="$HOME/.config/agent-worker-router/claude-limit-until"
  if [[ -f $claude_limit_file && ! -L $claude_limit_file ]]; then
    claude_limit_until=$(< "$claude_limit_file")
    if [[ $claude_limit_until == <-> ]] && (( claude_limit_until > $(date +%s) )); then
      die "Claude usage limit until $(limit_time "$claude_limit_until"); skipping call" 75
    fi
  fi
fi

if [[ $access == full ]]; then
  if [[ $worker == deepseek ]]; then
    if [[ -n $lease ]]; then
      # DeepSeek owns its dialog; ask cannot run inside a held lease.
      full_policy="$HOME/.config/agent-worker-router/full-access-policy"
      [[ -f $full_policy && ! -L $full_policy && $(< "$full_policy") == allow ]] || die 'DeepSeek full access with a lease requires the existing full-access allow policy; ask would hold the lease during its dialog' 2
    fi
  else
    "${0:A:h}/authorize-full" "$worker" "$dir" || die 'full access was not authorized' 2
  fi
fi

[[ -z $lease ]] || lease=${lease:a}
launch_file=$(mktemp "${TMPDIR:-/tmp}/agent-worker-started.XXXXXX")
# Worker exits 76/78 must not be mistaken for supervisor refusals before launch.
trap 'rm -f -- "$launch_file"' EXIT
if [[ $worker == deepseek ]]; then
  args=(-C "$dir" --timeout "$timeout")
  [[ $access != edit ]] || args=(--edit "${args[@]}")
  [[ $access != full ]] || args=(--full "${args[@]}")
  (( pro )) && args=(--pro "${args[@]}")
  [[ -z $evidence ]] || args=(--evidence "$evidence" "${args[@]}")
  command=("${0:A:h}/deepseek" "${args[@]}" "$brief")
  [[ -z $lease ]] || command=(env "$marker=$$" "AGENT_WORKER_ROUTER_LEASE_VAR=$marker" "${command[@]}")
  rc=0
  run_worker 0 "${command[@]}" || rc=$?
  [[ -s $launch_file || $rc != 78 ]] || die 'worker supervisor failed' 1
  exit $rc
fi

if [[ $worker == codex ]]; then
  config=${CODEX_HOME:-$HOME/.codex}/config.toml
  if [[ -f $config ]]; then
    # This reader accepts only single-line quoted scalars before the first table, never profiles.
    defaults=$(perl -ne 'last if /^\s*\[/; print "$1=$2\n" if /^\s*(model|model_reasoning_effort|model_provider)\s*=\s*"([^"\\]*)"\s*(?:#.*)?$/' "$config") || { warn 'could not read Codex defaults'; defaults=; }
    while IFS= read -r line; do
      key=${line%%=*} value=${line#*=}
      case $key in
        model) (( model_given )) && continue; valid_model "$value" && model=$value || warn 'ignoring invalid Codex default model' ;;
        model_reasoning_effort) (( effort_given )) && continue; valid_effort "$value" && effort=$value || warn 'ignoring invalid Codex default effort' ;;
        model_provider) (( provider_given )) && continue; valid_provider "$value" && provider=$value || warn 'ignoring invalid Codex default provider' ;;
      esac
    done <<< "$defaults"
  fi
  provider_table=
  if [[ -n $provider && -f $config ]]; then
    provider_table=$(perl -e '
      my ($id, $file) = @ARGV;
      open my $f, "<", $file or die "cannot read provider table\n";
      my (%keys, $inside, $found);
      while (<$f>) {
        if (/^\s*\[/) { $inside = /^\s*\[model_providers\.\Q$id\E\]\s*(?:#.*)?$/; $found ||= $inside; next }
        next unless $inside;
        $keys{$1} = qq{"$2"} if /^\s*(name|base_url|wire_api)\s*=\s*"([^"\\]*)"\s*(?:#.*)?$/;
        $keys{$1} = $2 if /^\s*(requires_openai_auth)\s*=\s*(true|false)\s*(?:#.*)?$/;
      }
      print "{", join(",", map { "$_=$keys{$_}" } grep { exists $keys{$_} } qw(name base_url wire_api requires_openai_auth)), "}" if $found;
    ' "$provider" "$config") || warn 'could not read Codex provider table'
  fi
else
  config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
  if [[ -e $config ]]; then
    if defaults=$(jq -sce 'select(length == 1 and (.[0] | type == "object")) | .[0] | {model,effortLevel}' "$config" 2>/dev/null); then
      for key in model effortLevel; do
        [[ $key != model || $model_given == 0 ]] || continue
        [[ $key != effortLevel || $effort_given == 0 ]] || continue
        print -r -- "$defaults" | jq -e --arg k "$key" '.[$k] != null' >/dev/null || continue
        value=$(print -r -- "$defaults" | jq -r --arg k "$key" '.[$k] | if type == "string" then . else "\u0001" end')
        if [[ $key == model ]]; then
          valid_model "$value" && model=$value || warn 'ignoring invalid Claude default model'
        else
          valid_effort "$value" && effort=$value || warn 'ignoring invalid Claude default effort'
        fi
      done
    else
      warn 'could not read valid Claude defaults'
    fi
  fi
fi

worker_env=("HOME=$HOME" "PATH=$PATH" "USER=${USER:-}" "LOGNAME=${LOGNAME:-}"
            SHELL=/bin/zsh "TMPDIR=${TMPDIR:-/tmp}" "LANG=${LANG:-en_US.UTF-8}" TERM=dumb)
for key in HTTPS_PROXY HTTP_PROXY ALL_PROXY NO_PROXY https_proxy http_proxy all_proxy no_proxy CODEX_HOME CLAUDE_CONFIG_DIR; do
  (( ${+parameters[$key]} )) || continue
  value=${(P)key}
  if [[ $key != CODEX_HOME && $key != CLAUDE_CONFIG_DIR && $value == *@* ]]; then
    warn "dropping $key because its proxy value contains credentials"
  else
    worker_env+=("$key=$value")
  fi
done
[[ -z $lease ]] || worker_env+=("$marker=$$" "AGENT_WORKER_ROUTER_LEASE_VAR=$marker")

out=$(mktemp "${TMPDIR:-/tmp}/agent-worker-router.XXXXXX")
emit_receipt() {
  local final_rc=$1 effective_model=unverified effective_effort=unverified effective_provider=unverified session=unverified tokens='"unverified"' key value
  (( ran )) || return 0
  if [[ $worker == codex ]]; then
    while IFS=$'\t' read -r key value; do
      case $key in
        model) effective_model=$value ;; effort) effective_effort=$value ;;
        provider) effective_provider=$value ;; session) session=$value ;;
      esac
    done < <(perl -ne '
      last if $. > 20;
      if (/^OpenAI Codex v/) { $seen = 1; next }
      next unless $seen;
      if (/^--------\s*$/) { last if $inside; $inside = 1; next }
      next unless $inside;
      print "$1\t$2\n" if /^(model|provider): (.+)$/;
      print "effort\t$1\n" if /^reasoning effort: (.+)$/;
      print "session\t$1\n" if /^session id: (.+)$/;
    ' "$out")
    value=$(perl -ne '
      if (/^tokens used\s*:?\s*([0-9][0-9,]*)?\s*$/) { $next = 1; $n = $1 if defined $1; next }
      if ($next && /^\s*([0-9][0-9,]*)\s*$/) { $n = $1 }
      $next = 0;
      END { if (defined $n) { $n =~ s/,//g; print $n } }
    ' "$out")
    [[ -z $value ]] || tokens=$(jq -nc --argjson total "$value" '{total:$total}')
    for key in model effort provider; do
      value=effective_$key
      if [[ -n ${(P)key} && ${(P)value} != unverified && ${(P)key} != ${(P)value} ]]; then
        warn "requested $key ${(P)key} but the CLI reports ${(P)value}"
      fi
    done
  elif jq -se 'length == 1 and (.[0] | type == "object")' "$out" >/dev/null 2>&1; then
    effective_model=$(jq -r '(.modelUsage // {}) | if type == "object" and length > 0 then keys | join(",") else "unverified" end' "$out")
    effective_effort=$(jq -r '.effort // "unverified"' "$out")
    session=$(jq -r '.session_id // "unverified"' "$out")
    tokens=$(jq -c 'try (if (.usage.input_tokens | type) == "number" and (.usage.output_tokens | type) == "number" then {input:.usage.input_tokens,output:.usage.output_tokens} else "unverified" end) catch "unverified"' "$out")
  fi
  print -ru2 -- "agent-worker-router: receipt $(jq -nc \
    --arg worker "$worker" --arg model "$effective_model" --arg effort "$effective_effort" \
    --arg provider "$effective_provider" --arg session "$session" --argjson exit "$final_rc" \
    --argjson duration "$SECONDS" --argjson tokens "$tokens" --argjson kept "$keep" \
    --arg requested_model "$model" --arg requested_effort "$effort" --arg requested_provider "$provider" --arg log "$out" \
    '{worker:$worker,model:$model,effort:$effort,provider:$provider,session:$session,exit:$exit,duration_s:$duration,tokens:$tokens,kept:($kept == 1),requested:{model:($requested_model | if . == "" then null else . end),effort:($requested_effort | if . == "" then null else . end),provider:($requested_provider | if . == "" then null else . end)},log:$log}')"
}
trap 'final_rc=$?; emit_receipt $final_rc; rm -f -- "$launch_file"' EXIT
cd "$dir"
rc=0
if [[ $worker == claude ]]; then
  claude_bin=$(whence -p claude) || die 'Claude Code CLI not found'
  # Agent hosts pass a socket as stdin and script(1) fails on it; it only needs a pty for the child.
  cli_help=$(env -i "${worker_env[@]}" /usr/bin/script -q /dev/null "$claude_bin" --help < /dev/null) || die 'could not inspect Claude Code CLI'
  for flag in --restricted --strict-mcp-config --safe-mode --no-session-persistence --disable-slash-commands --tools --permission-mode; do
    [[ $cli_help == *$flag* ]] || die "Claude Code CLI does not support $flag"
  done
  for flag in ${effort:+--effort} ${resume:+--resume}; do
    [[ $cli_help == *$flag* ]] || die "Claude Code CLI does not support $flag"
  done
  [[ $access != full || $cli_help == *--dangerously-skip-permissions* ]] || die 'Claude Code CLI does not support full access'
  tools=(Read Grep Glob)
  mode=dontAsk
  [[ $access != edit ]] || { tools+=(Edit Write); mode=acceptEdits; }
  args=(-p --safe-mode --strict-mcp-config)
  (( keep )) || args+=(--no-session-persistence)
  args+=(
        --disable-slash-commands --output-format json
        --permission-prompts none
        --disallowedTools 'Read(**/.env*)' 'Read(**/*.pem)' 'Read(**/*.key)' 'Read(**/*.p12)'
                          'Read(**/id_rsa*)' 'Read(**/id_ed25519*)' 'Read(**/.netrc)'
                          'Grep(**/.env*)' 'Grep(**/*.pem)' 'Grep(**/*.key)' 'Grep(**/*.p12)'
                          'Grep(**/id_rsa*)' 'Grep(**/id_ed25519*)' 'Grep(**/.netrc)'
                          'Edit(**/.env*)' 'Edit(**/*.pem)' 'Edit(**/*.key)' 'Edit(**/*.p12)'
                          'Edit(**/id_rsa*)' 'Edit(**/id_ed25519*)' 'Edit(**/.netrc)'
                          'Write(**/.env*)' 'Write(**/*.pem)' 'Write(**/*.key)' 'Write(**/*.p12)'
                          'Write(**/id_rsa*)' 'Write(**/id_ed25519*)' 'Write(**/.netrc)')
  if [[ $access == full ]]; then
    args+=(--dangerously-skip-permissions --tools default)
  else
    args+=(--restricted --permission-mode "$mode" --tools "${(j:,:)tools}")
  fi
  [[ -z $model ]] || args+=(--model "$model")
  [[ -z $effort ]] || args+=(--effort "$effort")
  [[ -z $resume ]] || args+=(--resume "$resume")
  print -rn -- "$brief" | run_worker "$timeout" env -i "${worker_env[@]}" \
      CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
      "$claude_bin" "${args[@]}" > "$out" || rc=$?
  if [[ ! -s $launch_file ]]; then
    (( rc != 76 )) || die "lease wait timed out: $lease" 76
    die 'worker supervisor failed' 1
  fi
  ran=1
  (( rc != 142 )) || die "timed out after ${timeout}s; partial JSON: $out" 124
  jq -e 'type == "object" and (.result | type == "string") and ((.modelUsage // {}) | type == "object")' "$out" >/dev/null || die "invalid Claude JSON (exit $rc): $out"
  foreign=$(jq -r '.modelUsage // {} | keys[] | select(startswith("claude-") | not)' "$out")
  [[ -z $foreign ]] || die "a non-Claude model responded: $foreign" 3
  if (( rc != 0 )) || [[ $(jq -r '.is_error' "$out") != false ]]; then
    failure=$(jq -r '.result // empty' "$out")
    print -u2 -- "$failure"
    if [[ $failure == *'session limit'* && $failure =~ 'resets ([0-9]{1,2})(:([0-9]{2}))?(am|pm) \(([-A-Za-z_+/]+)\)' ]]; then
      reset_hour=$match[1] reset_minute=${match[3]:-00} reset_period=$match[4] reset_zone=$match[5]
      if [[ -f /usr/share/zoneinfo/$reset_zone ]]; then
        reset_day=$(TZ="$reset_zone" date +%Y-%m-%d)
        reset_until=$(TZ="$reset_zone" date -j -f '%Y-%m-%d %I:%M:%S%p' "$reset_day $reset_hour:$reset_minute:00$reset_period" +%s) || reset_until=
        if [[ -n $reset_until ]]; then
          if (( reset_until <= $(date +%s) )); then
            reset_day=$(TZ="$reset_zone" date -v+1d +%Y-%m-%d)
            reset_until=$(TZ="$reset_zone" date -j -f '%Y-%m-%d %I:%M:%S%p' "$reset_day $reset_hour:$reset_minute:00$reset_period" +%s) || reset_until=
          fi
          if [[ -n $reset_until ]]; then
            mkdir -p "${claude_limit_file:h}"
            chmod 700 "${claude_limit_file:h}"
            limit_tmp=$(mktemp "${claude_limit_file:h}/claude-limit.XXXXXX")
            print -r -- "$reset_until" > "$limit_tmp"
            mv -- "$limit_tmp" "$claude_limit_file"
            print -u2 -- "agent-worker-router: Claude usage limit until $(limit_time "$reset_until"); future calls will be skipped"
          fi
        fi
      fi
    fi
    die "Claude failed (exit $rc): $out"
  fi
  jq -e '(.modelUsage // {} | length) > 0 and (.result | length > 0)' "$out" >/dev/null || die "empty Claude response: $out"
  jq -r '.result' "$out"
else
  codex_bin=$(whence -p codex) || die 'Codex CLI not found'
  cli_help=$(env -i "${worker_env[@]}" "$codex_bin" exec --help) || die 'could not inspect Codex CLI'
  for flag in --sandbox --ephemeral --ignore-user-config --output-last-message; do
    [[ $cli_help == *$flag* ]] || die "Codex CLI does not support $flag"
  done
  if [[ -n $resume ]]; then
    cli_help=$(env -i "${worker_env[@]}" "$codex_bin" exec resume --help) || die 'could not inspect Codex resume CLI'
    for flag in --ignore-user-config --output-last-message -c; do
      [[ $cli_help == *$flag* ]] || die "Codex resume CLI does not support $flag"
    done
  fi
  [[ $access != full || $cli_help == *--dangerously-bypass-approvals-and-sandbox* ]] || die 'Codex CLI does not support full access'
  answer=$(mktemp "${TMPDIR:-/tmp}/agent-worker-answer.XXXXXX")
  args=(exec)
  if [[ -n $resume ]]; then
    args+=(resume)
  elif (( ! keep )); then
    args+=(--ephemeral)
  fi
  args+=(--ignore-user-config --skip-git-repo-check --output-last-message "$answer")
  [[ -n $resume ]] || args+=(-C "$dir")
  case $access in
    read|edit)
      sandbox=read-only
      [[ $access != edit ]] || sandbox=workspace-write
      if [[ -n $resume ]]; then
        args+=(-c "sandbox_mode=\"$sandbox\"")
      else
        args+=(--sandbox "$sandbox")
      fi
      [[ $access != edit ]] || args+=(-c sandbox_workspace_write.network_access=false) ;;
    full) args+=(--dangerously-bypass-approvals-and-sandbox) ;;
  esac
  [[ -z $model ]] || args+=(-m "$model")
  [[ -z $effort ]] || args+=(-c "model_reasoning_effort=\"$effort\"")
  if [[ -n $provider ]]; then
    args+=(-c "model_provider=\"$provider\"")
    [[ -z $provider_table ]] || args+=(-c "model_providers.$provider=$provider_table")
  fi
  [[ -z $resume ]] || args+=("$resume")
  print -rn -- "$brief" | run_worker "$timeout" env -i "${worker_env[@]}" \
      "$codex_bin" "${args[@]}" - > "$out" 2>&1 || rc=$?
  if [[ ! -s $launch_file ]]; then
    (( rc != 76 )) || die "lease wait timed out: $lease" 76
    cat -- "$out" >&2
    die 'worker supervisor failed' 1
  fi
  ran=1
  (( rc != 142 )) || die "timed out after ${timeout}s; partial transcript: $out" 124
  (( rc == 0 )) && [[ -s $answer ]] || die "Codex exited without a response (exit $rc): $out" 1
  cat -- "$answer"
fi
