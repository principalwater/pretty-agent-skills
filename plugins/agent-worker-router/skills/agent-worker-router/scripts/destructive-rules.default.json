{
  "version": 4,
  "about": [
    "Destructive actions an agent session may run only after the user's own approval, never in checks. Read by",
    "`agent-worker-guard --destructive` on every tool call, so a new rule works at once. Install this file as",
    "~/.config/agent-worker-router/destructive-rules.json and keep the machine's own tools, accounts and MCP servers",
    "in destructive-rules.local.json next to it: same format; a rule with a known id replaces it, other rules, lists",
    "and option tables add up, messages and settings override. Agents may not edit either file; the guard refuses it.",
    "bash: command = basenames of the word a simple command runs; all given conditions must hold:",
    "  sub / sub2 (first / second positional word; sub_regex is an alternative to sub), sub_not, flags_any,",
    "  flags_all (groups), arg_prefix_any, launcher (a word before the command, e.g. sudo), outside_scratchpad (a path",
    "  argument leaves the session scratchpad), sql (a write statement in the query; sql_after_dashdash_with names a",
    "  flag after which the words past `--` are the query), repo_name_any (for git push also the remote's URL),",
    "  require_user (value of -u/--user must be one of these).",
    "git push: dev branches go without asking; ask for main/master, force or delete, and tags.",
    "  push_to_branches: the push may update one of these branches (explicit refspec; the current branch or its",
    "  upstream for a push without a refspec or with HEAD; --all, --branches, --mirror, matching), or the guard",
    "  cannot tell (unknown variable or directory, detached HEAD, not a repository).",
    "  push_tags: the push sends tags (--tags, --follow-tags, refs/tags/..., tag NAME, a local tag, push.followTags).",
    "  arg_prefix_any for git push looks at the refspecs in effect, the remote's configured ones included.",
    "  push_url_regex: a regex on the URL the push goes to (pushurl and insteadOf applied by git).",
    "option_values_any: {option: [values]}, e.g. {\"--visibility\": [\"public\"]} (the option takes a value per",
    "  global_value_options, or comes as --option=value).",
    "Safety net: when the parser does not see a command that the raw text runs (outside quotes, comments and",
    "  heredocs) and that a bash rule watches, the guard asks as for rule unparsed-command.",
    "mcp: tool = regex on the tool name; optional when {field, nonempty | equals, default} and sql_field.",
    "worker_deny_commands: agent-worker-router puts refusing stubs for these first on every Codex worker's PATH.",
    "launchers, launcher_options_end: wrappers that run the next command; the latter take options up to `--`.",
    "messages: replacements for the guard's texts (codex_why, codex_use, codex_launch, codex_agent, protect, rule).",
    "decision ask: Claude Code asks the user even in bypassPermissions; headless sessions turn ask into a denial.",
    "deny_in_permission_modes switches those modes to deny. selftest (local file): the local rules' own cases."
  ],
  "decision": "ask",
  "deny_in_permission_modes": [],
  "ask_message": "Destructive action: it needs your approval. Allow it only if it is your own decision.",
  "message": "This action needs the user's approval.",
  "scratchpad_globs": ["/private/tmp/claude-{uid}/*/{session_id}", "/tmp/claude-{uid}/*/{session_id}"],
  "global_value_options": {"git": ["-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--config-env"], "yt": ["--proxy", "--prefix", "--config", "--tx", "--master-cell-id"], "clickhouse": ["-q", "--query", "-h", "--host", "--port", "-u", "--user", "--password", "-d", "--database", "-f", "--format", "-C", "--config-file", "--queries-file", "--param_name"], "clickhouse-client": ["-q", "--query", "-h", "--host", "--port", "-u", "--user", "--password", "-d", "--database", "-f", "--format", "-C", "--config-file", "--queries-file"], "kubectl": ["-n", "--namespace", "--context", "--kubeconfig", "--cluster", "--user", "-s", "--server"], "airflow": []},
  "sql_safe_statements": ["SYSTEM FLUSH LOGS"],
  "sql_read_statements": ["SELECT", "WITH", "SHOW", "DESCRIBE", "DESC", "EXPLAIN", "EXISTS", "USE", "SET", "CHECK", "WATCH", "VALUES", "PRAGMA", "DECLARE", "DEFINE", "END", "COMMIT", "DISCARD", "PROCESS", "REDUCE", "IMPORT", "EVALUATE", "DO"],
  "bash": [
    {"id": "rm-recursive", "command": ["rm"], "flags_all": [["-r", "-R", "--recursive"]], "outside_scratchpad": true, "why": "recursive delete outside the session scratchpad"},
    {"id": "find-delete", "command": ["find"], "flags_any": ["-delete"], "outside_scratchpad": true, "why": "find -delete outside the session scratchpad"},
    {"id": "shred", "command": ["shred", "srm"], "why": "files wiped beyond recovery"},
    {"id": "git-push-force", "command": ["git"], "sub": ["push"], "flags_any": ["-f", "--force", "--force-with-lease", "--force-if-includes", "--mirror", "--prune"], "why": "git push that rewrites history"},
    {"id": "git-push-force-refspec", "command": ["git"], "sub": ["push"], "arg_prefix_any": ["+"], "why": "git push +refspec rewrites history"},
    {"id": "git-push-delete", "command": ["git"], "sub": ["push"], "flags_any": ["-d", "--delete"], "why": "deletes a branch or tag on the remote"},
    {"id": "git-push-delete-refspec", "command": ["git"], "sub": ["push"], "arg_prefix_any": [":"], "why": "git push :ref deletes a branch on the remote"},
    {"id": "git-push-main", "command": ["git"], "sub": ["push"], "push_to_branches": ["main", "master"], "why": "a push that may update main/master needs the user's approval"},
    {"id": "git-push-tags", "command": ["git"], "sub": ["push"], "push_tags": true, "why": "pushes tags, not a dev branch"},
    {"id": "git-reset-hard", "command": ["git"], "sub": ["reset"], "flags_any": ["--hard"], "why": "git reset --hard loses uncommitted work"},
    {"id": "git-branch-delete", "command": ["git"], "sub": ["branch"], "flags_any": ["-d", "-D", "--delete"], "why": "deletes a branch"},
    {"id": "git-tag-delete", "command": ["git"], "sub": ["tag"], "flags_any": ["-d", "--delete"], "why": "deletes a tag"},
    {"id": "git-clean-force", "command": ["git"], "sub": ["clean"], "flags_any": ["-f", "--force"], "why": "git clean deletes untracked files"},
    {"id": "git-stash-drop", "command": ["git"], "sub": ["stash"], "sub2": ["drop", "clear"], "why": "drops a stash"},
    {"id": "git-history-prune", "command": ["git"], "sub": ["reflog", "gc", "update-ref"], "flags_any": ["--expire", "--prune", "-d"], "why": "destroys reflog entries or refs"},
    {"id": "clickhouse-client-write-sql", "command": ["clickhouse"], "sub": ["client"], "sql": true, "why": "DDL or DML through clickhouse client"},
    {"id": "clickhouse-client-binary-write-sql", "command": ["clickhouse-client"], "sql": true, "why": "DDL or DML through clickhouse-client"},
    {"id": "yt-write", "command": ["yt"], "sub": ["create", "create-account", "create-pool", "create-temp-table", "write", "write-table", "write-file", "upload", "set", "set-attribute", "copy", "move", "link", "remove", "remove-attribute", "externalize", "internalize", "concatenate", "mount-table", "unmount-table", "remount-table", "reshard-table", "reshard-table-automatic", "balance-tablet-cells", "trim-rows", "alter-table", "freeze-table", "unfreeze-table", "alter-table-replica", "insert-rows", "insert", "delete-rows", "delete", "register-queue-consumer", "unregister-queue-consumer", "advance-consumer", "advance-queue-consumer", "push-queue-producer", "create-queue-producer-session", "remove-queue-producer-session", "abort-query", "alter-query", "erase", "merge", "sort", "map", "reduce", "join-reduce", "map-reduce", "remote-copy", "vanilla", "shuffle", "abort-op", "suspend-op", "resume-op", "complete-op", "update-op-parameters", "patch-op-spec", "abort-tx", "commit-tx", "lock", "unlock", "add-member", "remove-member", "execute", "execute-batch", "transfer-account-resources", "transfer-pool-resources", "set-user-password", "issue-token", "revoke-token", "abort-job", "run-job-shell", "run-job-shell-command", "transform", "upload-parquet", "upload-orc", "run-command-with-lock", "add-maintenance", "remove-maintenance"], "why": "changes data or operations in YTsaurus"},
    {"id": "yt-query-write", "command": ["yt"], "sub": ["start-query", "query"], "sql": true, "why": "a YQL query that writes to YTsaurus"},
    {"id": "airflow-dags-change", "command": ["airflow"], "sub": ["dags"], "sub2": ["trigger", "delete", "pause", "unpause", "backfill", "reserialize", "test"], "why": "changes Airflow DAGs"},
    {"id": "airflow-tasks-change", "command": ["airflow"], "sub": ["tasks"], "sub2": ["clear", "run", "test"], "why": "runs or clears Airflow tasks"},
    {"id": "airflow-admin-change", "command": ["airflow"], "sub": ["db", "variables", "connections", "pools", "users"], "sub2": ["reset", "clean", "downgrade", "migrate", "upgrade", "set", "delete", "import", "add", "create"], "why": "administrative change in Airflow"},
    {"id": "launchctl", "command": ["launchctl"], "sub_not": ["list", "print", "print-disabled", "print-cache", "blame", "version", "help", "procinfo", "hostinfo", "managername", "managerpid", "manageruid", "getenv", "error", "examine", "dumpstate", "dumpjpcategory", "resolveport"], "why": "launchctl changes background services"},
    {"id": "keychain-secrets", "command": ["security"], "sub": ["find-generic-password", "find-internet-password", "dump-keychain", "export", "delete-generic-password", "delete-internet-password", "delete-keychain", "delete-certificate", "delete-identity", "add-generic-password", "add-internet-password", "add-certificates", "import", "unlock-keychain", "set-generic-password-partition-list", "set-internet-password-partition-list", "set-keychain-password", "create-keychain"], "why": "reads or changes Keychain secrets"},
    {"id": "osascript", "command": ["osascript"], "why": "osascript drives applications outside the sandbox"},
    {"id": "sudo", "launcher": ["sudo"], "why": "runs as root"},
    {"id": "kill-by-name", "command": ["pkill", "killall"], "why": "kills processes by name"},
    {"id": "crontab-remove", "command": ["crontab"], "flags_any": ["-r"], "why": "removes the crontab"},
    {"id": "disk-erase", "command": ["diskutil"], "sub": ["eraseDisk", "eraseVolume", "reformat", "partitionDisk", "secureErase", "zeroDisk", "randomDisk"], "why": "erases or repartitions a disk"},
    {"id": "disk-apfs-delete", "command": ["diskutil"], "sub": ["apfs"], "sub2": ["deleteVolume", "deleteContainer", "eraseVolume", "deleteSnapshot"], "why": "deletes an APFS volume"},
    {"id": "dd-to-device", "command": ["dd"], "arg_prefix_any": ["of=/dev/"], "why": "writes to a device"},
    {"id": "mkfs", "command": ["mkfs", "newfs_apfs", "newfs_hfs", "newfs_msdos", "newfs_exfat"], "why": "creates a file system"},
    {"id": "kubectl-change", "command": ["kubectl"], "sub": ["delete", "apply", "create", "replace", "patch", "scale", "rollout", "drain", "cordon", "uncordon", "edit", "set", "annotate", "label", "taint", "exec", "cp", "run", "expose", "autoscale"], "why": "changes a Kubernetes cluster"},
    {"id": "gh-delete", "command": ["gh"], "sub": ["repo", "release"], "sub2": ["delete", "archive"], "why": "deletes on GitHub"}
  ],
  "mcp": [
    {"id": "airflow-clear", "tool": "^mcp__airflow[a-z0-9-]*__(clear_dag_run|clear_task_instances)$", "when": {"field": "dry_run", "equals": false, "default": true}, "why": "clears Airflow runs without dry_run"},
    {"id": "airflow-change", "tool": "^mcp__airflow[a-z0-9-]*__(delete_dag_run|trigger_dag|trigger_dag_and_wait|pause_dag|unpause_dag)$", "why": "changes Airflow"},
    {"id": "clickhouse-write", "tool": "^mcp__clickhouse[a-z0-9-]*__run_query$", "sql_field": "query", "why": "DDL or DML in ClickHouse"},
    {"id": "jira-write", "tool": "^mcp__(?:[a-z0-9-]+_)?jira__(create_issue|update_issue|add_comment|transition_issue|link_issues|delete_issue_link|delete_issue_attachment|upload_issue_attachments)$", "why": "writes to Jira"},
    {"id": "gitlab-write", "tool": "^mcp__(?:[a-z0-9-]+_)?gitlab__(add_merge_request_note|create_discussion|create_merge_request|update_merge_request|reply_to_discussion|resolve_discussion|run_job)$", "why": "writes to GitLab"},
    {"id": "confluence-write", "tool": "^mcp__(?:[a-z0-9-]+_)?confluence__(?:confluence_)?(create_page|update_page|update_page_section|move_page|reply_to_footer_comment|reply_to_inline_comment)$", "why": "writes to Confluence"},
    {"id": "session-delete", "tool": "^mcp__ccd_session_mgmt__delete_session$|^mcp__ccd_host__(discard_kept_worktree|clean_up_worktrees)$|^mcp__scheduled-tasks__delete_scheduled_task$", "why": "deletes a session, worktree or scheduled task"}
  ],
  "worker_deny_commands": ["clickhouse", "clickhouse-client", "yt", "airflow", "kubectl", "psql", "security", "launchctl", "osascript", "gh", "glab"]
}
