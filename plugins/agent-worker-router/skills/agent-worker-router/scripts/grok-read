#!/bin/zsh
# Called inside the router's lease, timeout and filtered environment.
set -euo pipefail
grok=$1
shift
base=(--no-auto-update --sandbox minimal)
# MCP tools are separate from Grok's built-in allowlist; hooks and plugins can also run code.
if ! "$grok" "${base[@]}" inspect --json </dev/null | jq -es '
    length == 1 and (.[0] | (.hookLoadErrors == null or .hookLoadErrors == []) and ([.hooks, .plugins, .mcpServers, .lspServers] | all(. == [])))
  ' >/dev/null; then
  print -u2 -- 'agent-worker-router: Grok needs a workspace and configuration without hooks, plugins, MCP or LSP servers'
  exit 1
fi
args=(--verbatim --output-format json --permission-mode dontAsk --tools read_file,grep,list_dir
      --disable-web-search --no-memory --no-plan --no-subagents)
for pattern in '~/.grok/**' '**/.env*' '**/*.pem' '**/*.key' '**/*.p12' '**/id_rsa*' '**/id_ed25519*' '**/.netrc'; do
  args+=(--deny "Read($pattern)" --deny "Grep($pattern)")
done
exec "$grok" "${base[@]}" "${args[@]}" "$@"
