#!/bin/zsh
# Отдельная связка не нужна: login разблокируется вместе со входом в macOS.
set -euo pipefail
umask 077

service=pretty-agent-deepseek-worker
account=default
keychain="$HOME/Library/Keychains/login.keychain-db"
settings="$HOME/.config/deepseek-worker/claude/settings.json"
helper='/usr/bin/security find-generic-password -s pretty-agent-deepseek-worker -a default -w "$HOME/Library/Keychains/login.keychain-db"'

case ${1:-} in
  --help|-h)
    print 'usage: setup --from-clipboard | --from-keychain SERVICE ACCOUNT | --check | --full-access allow|ask|deny'
    exit 0 ;;
  --full-access)
    (( $# == 2 )) || { print -u2 'setup: --full-access ждёт allow, ask или deny'; exit 2; }
    [[ $2 == allow || $2 == ask || $2 == deny ]] || { print -u2 'setup: --full-access ждёт allow, ask или deny'; exit 2; }
    mkdir -p "$HOME/.config/agent-worker-router"
    chmod 700 "$HOME/.config/agent-worker-router"
    policy="$HOME/.config/agent-worker-router/full-access-policy"
    if [[ $2 == deny ]]; then
      rm -f -- "$policy"
      print 'setup: full access отключён'
      exit 0
    fi
    tmp=$(mktemp "$HOME/.config/agent-worker-router/full-access.XXXXXX")
    print "$2" > "$tmp"
    mv -- "$tmp" "$policy"
    print "setup: режим full access: $2. Каждый запуск требует --access full; allow не задаёт дополнительных вопросов, ask требует macOS-диалог. Это не sandbox: воркер сможет читать Keychain и файлы пользователя."
    exit 0 ;;
  --check)
    [[ -f $settings ]] || { print -u2 'setup: настройки не найдены'; exit 1; }
    whence -p jq >/dev/null || { print -u2 'setup: не найдена команда jq'; exit 1; }
    jq -e --arg h "$helper" '.apiKeyHelper == $h and .env.ANTHROPIC_BASE_URL == "https://api.deepseek.com/anthropic"' "$settings" >/dev/null || { print -u2 'setup: настройки DeepSeek неверны'; exit 1; }
    key=$(/usr/bin/security find-generic-password -s "$service" -a "$account" -w "$keychain") || { print -u2 'setup: запись Keychain не найдена'; exit 1; }
    [[ $key =~ '^sk-[A-Za-z0-9_-]{16,}$' ]] || { unset key; print -u2 'setup: в Keychain нет ключа DeepSeek'; exit 1; }
    unset key
    whence -p claude >/dev/null || { print -u2 'setup: установите Claude Code CLI'; exit 1; }
    print 'setup: конфигурация, Keychain и Claude Code готовы'
    exit 0 ;;
  --from-clipboard|--from-keychain) ;;
  *) print -u2 'usage: setup --from-clipboard | --from-keychain SERVICE ACCOUNT | --check | --full-access allow|ask|deny'; exit 2 ;;
esac

[[ $(uname -s) == Darwin ]] || { print -u2 'setup: нужен macOS Keychain'; exit 1; }
for tool in jq claude; do
  whence -p "$tool" >/dev/null || { print -u2 "setup: не найдена команда $tool"; exit 1; }
done
[[ -f $keychain ]] || { print -u2 'setup: login Keychain не найдена'; exit 1; }

if [[ $1 == --from-clipboard ]]; then
  for tool in pbpaste pbcopy; do
    whence -p "$tool" >/dev/null || { print -u2 "setup: не найдена команда $tool"; exit 1; }
  done
  trap 'pbcopy < /dev/null' EXIT
  key=$(pbpaste)
  source_label=буфере
else
  (( $# == 3 )) || { print -u2 'setup: нужны SERVICE и ACCOUNT исходной записи'; exit 2; }
  key=$(/usr/bin/security find-generic-password -s "$2" -a "$3" -w) || { print -u2 'setup: исходная запись Keychain не найдена'; exit 1; }
  source_label=Keychain
fi
[[ $key =~ '^sk-[A-Za-z0-9_-]{16,}$' ]] || { unset key; print -u2 "setup: в $source_label не ключ DeepSeek (sk-…); ничего не записано"; exit 1; }

# security -i получает ключ только по stdin: ни argv, ни конфиг его не содержат.
printf 'add-generic-password -U -a %s -s %s -T /usr/bin/security -w %s "%s"\n' "$account" "$service" "$key" "$keychain" | /usr/bin/security -i >/dev/null
stored=$(/usr/bin/security find-generic-password -s "$service" -a "$account" -w "$keychain") || { unset key; print -u2 'setup: не удалось прочитать новую запись'; exit 1; }
[[ $stored == $key ]] || { unset stored key; print -u2 'setup: записанный ключ не совпадает с исходным'; exit 1; }
unset stored
unset key

mkdir -p "$HOME/.config/deepseek-worker/claude"
chmod 700 "$HOME/.config/deepseek-worker" "$HOME/.config/deepseek-worker/claude"
tmp=$(mktemp "$HOME/.config/deepseek-worker/claude/settings.XXXXXX")
if [[ $1 == --from-clipboard ]]; then
  trap 'pbcopy < /dev/null; if [[ -n ${tmp:-} && -e $tmp ]]; then rm -- "$tmp"; fi' EXIT
else
  trap 'if [[ -n ${tmp:-} && -e $tmp ]]; then rm -- "$tmp"; fi' EXIT
fi
jq -n --arg h "$helper" '{apiKeyHelper:$h, model:"deepseek-flash[1m]", effortLevel:"max", env:{ANTHROPIC_BASE_URL:"https://api.deepseek.com/anthropic", ANTHROPIC_DEFAULT_OPUS_MODEL:"deepseek-v4-pro", ANTHROPIC_DEFAULT_SONNET_MODEL:"deepseek-flash[1m]", ANTHROPIC_DEFAULT_HAIKU_MODEL:"deepseek-flash", CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:"1"}}' > "$tmp"
mv -- "$tmp" "$settings"
tmp=
print 'setup: ключ сохранён в login Keychain. Любой процесс этого пользователя, запускающий /usr/bin/security, может читать этот item без повторного запроса.'
