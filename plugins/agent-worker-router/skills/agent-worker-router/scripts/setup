#!/bin/zsh
# The login Keychain unlocks with the macOS user session.
set -euo pipefail
umask 077

service=pretty-agent-deepseek-worker
account=default
keychain="$HOME/Library/Keychains/login.keychain-db"
settings="$HOME/.config/deepseek-worker/claude/settings.json"
helper='/usr/bin/security find-generic-password -s pretty-agent-deepseek-worker -a default -w "$HOME/Library/Keychains/login.keychain-db"'

case ${1:-} in
  --help|-h)
    print 'usage: setup --from-clipboard | --from-keychain SERVICE ACCOUNT | --check | --full-access allow|ask|deny'
    exit 0 ;;
  --full-access)
    (( $# == 2 )) || { print -u2 'setup: --full-access requires allow, ask, or deny'; exit 2; }
    [[ $2 == allow || $2 == ask || $2 == deny ]] || { print -u2 'setup: --full-access requires allow, ask, or deny'; exit 2; }
    mkdir -p "$HOME/.config/agent-worker-router"
    chmod 700 "$HOME/.config/agent-worker-router"
    policy="$HOME/.config/agent-worker-router/full-access-policy"
    if [[ $2 == deny ]]; then
      rm -f -- "$policy"
      print 'setup: full access disabled'
      exit 0
    fi
    tmp=$(mktemp "$HOME/.config/agent-worker-router/full-access.XXXXXX")
    print "$2" > "$tmp"
    mv -- "$tmp" "$policy"
    print "setup: full access mode: $2. Every invocation requires --access full; allow asks no further questions, while ask requires a macOS dialog. This is not a sandbox: the worker can read Keychain and user files."
    exit 0 ;;
  --check)
    [[ -f $settings ]] || { print -u2 'setup: settings not found'; exit 1; }
    whence -p jq >/dev/null || { print -u2 'setup: jq not found'; exit 1; }
    jq -e --arg h "$helper" '.apiKeyHelper == $h and .env.ANTHROPIC_BASE_URL == "https://api.deepseek.com/anthropic"' "$settings" >/dev/null || { print -u2 'setup: invalid DeepSeek settings'; exit 1; }
    key=$(/usr/bin/security find-generic-password -s "$service" -a "$account" -w "$keychain") || { print -u2 'setup: Keychain item not found'; exit 1; }
    [[ $key =~ '^sk-[A-Za-z0-9_-]{16,}$' ]] || { unset key; print -u2 'setup: Keychain item is not a DeepSeek key'; exit 1; }
    unset key
    whence -p claude >/dev/null || { print -u2 'setup: install Claude Code CLI'; exit 1; }
    print 'setup: configuration, Keychain, and Claude Code are ready'
    exit 0 ;;
  --from-clipboard|--from-keychain) ;;
  *) print -u2 'usage: setup --from-clipboard | --from-keychain SERVICE ACCOUNT | --check | --full-access allow|ask|deny'; exit 2 ;;
esac

[[ $(uname -s) == Darwin ]] || { print -u2 'setup: macOS Keychain is required'; exit 1; }
for tool in jq claude; do
  whence -p "$tool" >/dev/null || { print -u2 "setup: $tool not found"; exit 1; }
done
[[ -f $keychain ]] || { print -u2 'setup: login Keychain not found'; exit 1; }

if [[ $1 == --from-clipboard ]]; then
  for tool in pbpaste pbcopy; do
    whence -p "$tool" >/dev/null || { print -u2 "setup: $tool not found"; exit 1; }
  done
  trap 'pbcopy < /dev/null' EXIT
  key=$(pbpaste)
  source_label='clipboard'
else
  (( $# == 3 )) || { print -u2 'setup: source SERVICE and ACCOUNT are required'; exit 2; }
  key=$(/usr/bin/security find-generic-password -s "$2" -a "$3" -w) || { print -u2 'setup: source Keychain item not found'; exit 1; }
  source_label='Keychain item'
fi
[[ $key =~ '^sk-[A-Za-z0-9_-]{16,}$' ]] || { unset key; print -u2 "setup: $source_label does not contain a DeepSeek key (sk-...); nothing was written"; exit 1; }

# security -i receives the key on stdin, never in argv or configuration.
printf 'add-generic-password -U -a %s -s %s -T /usr/bin/security -w %s "%s"\n' "$account" "$service" "$key" "$keychain" | /usr/bin/security -i >/dev/null
stored=$(/usr/bin/security find-generic-password -s "$service" -a "$account" -w "$keychain") || { unset key; print -u2 'setup: could not read the new Keychain item'; exit 1; }
[[ $stored == $key ]] || { unset stored key; print -u2 'setup: stored key does not match the source'; exit 1; }
unset stored
unset key

mkdir -p "$HOME/.config/deepseek-worker/claude"
chmod 700 "$HOME/.config/deepseek-worker" "$HOME/.config/deepseek-worker/claude"
tmp=$(mktemp "$HOME/.config/deepseek-worker/claude/settings.XXXXXX")
if [[ $1 == --from-clipboard ]]; then
  trap 'pbcopy < /dev/null; if [[ -n ${tmp:-} && -e $tmp ]]; then rm -- "$tmp"; fi' EXIT
else
  trap 'if [[ -n ${tmp:-} && -e $tmp ]]; then rm -- "$tmp"; fi' EXIT
fi
jq -n --arg h "$helper" '{apiKeyHelper:$h, model:"deepseek-flash[1m]", effortLevel:"max", env:{ANTHROPIC_BASE_URL:"https://api.deepseek.com/anthropic", ANTHROPIC_DEFAULT_OPUS_MODEL:"deepseek-v4-pro", ANTHROPIC_DEFAULT_SONNET_MODEL:"deepseek-flash[1m]", ANTHROPIC_DEFAULT_HAIKU_MODEL:"deepseek-flash", CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:"1"}}' > "$tmp"
mv -- "$tmp" "$settings"
tmp=
print 'setup: key stored in the login Keychain. Any process running as this user can read the item through /usr/bin/security without another prompt.'
